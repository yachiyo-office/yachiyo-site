---
import '../../styles/service-detail.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LineButton from '../../components/LineButton.astro';
import BasicContentVisual from '../../components/BasicContentVisual.astro';
import { pageTitle } from '../../config/site';

const targetCases = [
  '500万円未満の解体工事を請けているが、登録や許可を持っていない',
  '元請や取引先から、解体工事業の登録番号を求められた',
  '大阪府だけでなく、和歌山県の現場も請けたい',
  '登録の有効期限（5年）が近づいているが、手続きが進まない',
  '技術管理者を誰にするか、今の従業員で足りるのか分からない',
  '技術管理者が退職・交代するため、変更届が必要になった',
];

const keyPoints = [
  {
    no: '01',
    title: '「許可があるか」で、登録が要るかどうかが決まる',
    text: '土木工事業・建築工事業・解体工事業のいずれかの建設業許可があれば、解体工事業の登録は不要です。とび・土工工事業の許可だけでは不要になりません。請負金額が500万円未満でも、許可か登録のどちらかがなければ解体工事は請け負えません。',
  },
  {
    no: '02',
    title: '登録は「工事をする都道府県」ごとに必要',
    text: '本店のある県で登録すれば全国で工事できる、という仕組みではありません。大阪府と和歌山県の両方で解体工事をするなら、それぞれの知事の登録が必要です。事業エリアを先に整理すると、費用と手続きの見通しが立ちます。',
  },
  {
    no: '03',
    title: '技術管理者を、資格か実務経験で証明できるか',
    text: '登録の最大の山は技術管理者です。資格で証明できる場合は比較的スムーズですが、実務経験で証明する場合は、年ごとの工事内容と証明者の確認が必要です。ここが案件の難易度と所要期間を左右します。',
  },
];

const requirements = [
  {
    name: '技術管理者の選任',
    detail:
      '省令の基準に合う人を技術管理者として選任します。資格で選任する場合と、実務経験の年数で選任する場合があります。',
  },
  {
    name: '登録拒否事由に該当しないこと',
    detail:
      '申請者（法人は役員全員）が、法律で定める欠格の事由に当たらないことが必要です。申請前に、欠格確認書で一つずつ確認します。',
  },
  {
    name: '営業所の実体',
    detail:
      '営業所の所在を示す資料が必要です。登記・住民票の住所と営業所が違う場合は、賃貸契約書や使用承諾書なども確認されます。',
  },
];

const engineerRoutes = [
  {
    name: '資格で選任する',
    detail:
      '建設機械施工技士、土木施工管理技士、建築施工管理技士、建築士、技術士（建設部門）、1級のとび技能士、解体工事施工技士などです。2級は種別の指定があり、2級だからすべて認められるわけではありません。',
  },
  {
    name: '実務経験で選任する',
    detail:
      '解体工事の実務経験が、大学・高専卒（一定の学科）で2年以上、高校卒（一定の学科）で4年以上、それ以外は8年以上です。国土交通大臣の登録講習（解体工事施工技術講習）を修了すると、1年短縮できる区分があります。',
  },
  {
    name: '実務経験の証明で注意すること',
    detail:
      '大阪府の手引きでは、平成13年12月以降の経験は、証明者がその期間に土木・建築・解体の許可業者、または解体工事業登録業者であることが必要です。証明が取れない場合の扱いは、申請先の手引きによります。',
  },
];

const documents = [
  {
    name: '登録申請書・誓約書・調書',
    detail: '申請者の情報、技術管理者、営業所などを記載します。当事務所で作成します。',
  },
  {
    name: '登記事項証明書（法人）／住民票（個人）',
    detail: '申請者の所在の確認に使います。発行後3か月以内のものが必要です。',
  },
  {
    name: '技術管理者の資格・経験を示す書類',
    detail:
      '資格証明書、講習の修了証、卒業証明書、実務経験証明書など。どの方法で証明するかで変わります。',
  },
  {
    name: '技術管理者の在籍を示す書類',
    detail:
      '技術管理者が代表者以外の場合に必要です。標準報酬決定通知書、雇用保険の資格が分かる書類、給与台帳などで確認します。',
  },
  {
    name: '営業所の使用権限を示す書類',
    detail: '賃貸契約書の写し、使用承諾書、建物登記簿など。営業所の状況により異なります。',
  },
  {
    name: '欠格確認書・委任状',
    detail:
      '欠格に当たらないことの確認書と、登録先の様式に沿った委任状です。当事務所でご案内し、作成します。',
  },
];

const flowSteps = [
  {
    step: 'STEP 1',
    title: 'お問い合わせ・無料相談',
    period: '当日〜数日',
    text: '解体工事をする都道府県、お持ちの建設業許可、技術管理者の候補をお伺いします。そもそも登録が必要かどうかの確認から始められます。',
  },
  {
    step: 'STEP 2',
    title: '要件の確認・お見積り',
    period: '数日',
    text: '技術管理者を資格・講習・実務経験のどれで証明するかを整理し、報酬と法定費用を明示したお見積りをご提示します。',
  },
  {
    step: 'STEP 3',
    title: '書類の収集・作成',
    period: '1〜2週間',
    text: '必要書類一覧をお渡しし、お客様に準備いただくものと、当事務所が作成するものを分けて進めます。住民票・登記事項証明書などは代理取得できます。',
  },
  {
    step: 'STEP 4',
    title: '申請',
    period: '準備が整い次第',
    text: '登録先の窓口へ申請します。大阪府は、新規・更新の申請は咲洲庁舎の窓口提出です（郵送不可）。当事務所で提出します。',
  },
  {
    step: 'STEP 5',
    title: '登録・ご案内',
    period: '大阪府は4週間程度',
    text: '補正があれば対応し、登録の通知までフォローします。登録後は、営業所と現場への標識の掲示、更新時期、変更届の期限などをご案内します。',
  },
];

const costRows = [
  {
    name: '解体工事業者登録（新規）',
    detail: '1都道府県',
    fee: '55,000円〜',
    legal: '33,000円',
  },
  {
    name: '解体工事業者登録（更新）',
    detail: '5年ごとの更新　1都道府県',
    fee: '44,000円〜',
    legal: '26,000円',
  },
  {
    name: '解体工事業者登録（変更届）',
    detail: '技術管理者・所在地の変更 等',
    fee: '16,500円〜',
    legal: '原則なし',
  },
];

const faqItems = [
  {
    q: '500万円未満の解体工事でも、登録は必要ですか？',
    a: '必要です。解体工事は、請負金額が小さくても、建設業許可（土木・建築・解体のいずれか）か解体工事業の登録のどちらかが必要です。登録を受けずに解体工事業を営むと、罰則の対象になります。',
  },
  {
    q: '建設業許可を持っていれば、登録は不要ですか？',
    a: '土木工事業・建築工事業・解体工事業のいずれかの許可があれば不要です。内装仕上工事業やとび・土工工事業など、これら3業種以外の許可だけでは不要になりません。許可の業種を確認させていただければ、要否をお答えします。',
  },
  {
    q: '大阪府の登録で、和歌山県の工事もできますか？',
    a: 'できません。登録は工事をする都道府県ごとに必要です。大阪府と和歌山県の両方で工事をする場合は、それぞれに登録します。有効期間も、それぞれの登録ごとに管理します。',
  },
  {
    q: '登録のあとで建設業許可を取ったら、どうなりますか？',
    a: '土木工事業・建築工事業・解体工事業のいずれかの許可を受けると、解体工事業の登録は不要になり、登録を受けていた都道府県への通知が必要です。大阪府は、許可後30日以内の抹消の通知を案内しています。将来、許可の取得を考えている場合は、順序もあわせてご相談ください。',
  },
  {
    q: '技術管理者が退職したら、どうすればよいですか？',
    a: '後任が基準に合うことを確認したうえで、変更の日から30日以内に、登録先の都道府県へ変更届を出します。大阪府と和歌山県の両方で登録している場合は、それぞれ手続きが必要です。',
  },
  {
    q: '登録の有効期間と、更新の時期を教えてください。',
    a: '有効期間は5年です。有効期間が満了する日の30日前までに更新を申請します。大阪府は、満了日の3か月前から更新の申請を受け付けています。当事務所でご依頼いただいた場合は、更新時期が近づいたらご案内します。',
  },
  {
    q: '解体工事で出る廃棄物を運ぶ場合、産廃の許可も必要ですか？',
    a: '解体工事業の登録とは別の制度です。他人の廃棄物を業として運ぶなど、運び方によっては産業廃棄物収集運搬業の許可が必要です。工事の進め方をお伺いして、必要な手続きを整理します。',
  },
];

const relatedLinks = [
  {
    title: '解体工事業者が整えるべき3つの手続き',
    text: '建設業許可・解体工事業登録・産廃収集運搬許可の関係と、手数料・期間の比較を整理しています。',
    href: '/blog/kaitai-gyosha-3-tetsuzuki-set/',
  },
  {
    title: '解体工事業の技術管理者とは',
    text: '資格・実務経験の主な基準と、変更届の期限を解説しています。',
    href: '/blog/kaitai-gijutsu-kanrisha-shikaku-yoken/',
  },
  {
    title: '解体工事業の許可と登録の違い',
    text: '500万円の基準と、許可・登録のどちらが必要かの考え方をまとめています。',
    href: '/blog/kaitai-kogyo-kyoka-toroku-chigai/',
  },
  {
    title: '産業廃棄物収集運搬業許可',
    text: '解体工事で出る廃棄物を運ぶ場合の許可について、ご案内しています。',
    href: '/service/industrial-waste/',
  },
  {
    title: '建設業許可 新規申請',
    text: '解体工事業の建設業許可を取得したい場合の流れをご案内します。',
    href: '/construction-permit/new/',
  },
  {
    title: '料金案内',
    text: '解体工事業登録以外の手続の費用目安も一覧で確認できます。',
    href: '/price/',
  },
];
---

<BaseLayout
  title={pageTitle('解体工事業者登録（解体工事業登録）のサポート')}
  description="大阪府・和歌山県の解体工事業者登録（建設リサイクル法）をサポート。新規・更新・変更届、技術管理者の要件確認から書類作成、申請まで。500万円未満の解体工事を請ける事業者さま向け。"
  breadcrumbs={[
    { name: 'ホーム', href: '/' },
    { name: '業務案内', href: '/service/' },
    { name: '解体工事業登録' },
  ]}
>
  <div class="page">
    <SiteHeader />

    <main>
      <section class="page-hero section--base" aria-labelledby="page-heading">
        <div class="page-hero__inner">
          <nav class="breadcrumb" aria-label="パンくずリスト">
            <ol>
              <li><a href="/">ホーム</a></li>
              <li><a href="/service/">業務案内</a></li>
              <li aria-current="page">解体工事業登録</li>
            </ol>
          </nav>

          <div class="page-hero__content">
            <p class="page-hero__label">SERVICE</p>
            <h1 id="page-heading" class="page-hero__title">
              解体工事業者登録<br />（解体工事業登録）のサポート
            </h1>
            <p class="page-hero__lead">
              建設業許可（土木・建築・解体）がない事業者さまが<strong>解体工事を業として行う</strong>には、
              建設リサイクル法に基づく登録が必要です。
              やちよ行政書士事務所では、大阪府・和歌山県の登録の新規・更新・変更届をサポートします。
            </p>
            <p class="page-hero__note">
              「500万円未満だから何もいらない」と思っていた、という段階からご相談いただけます。
            </p>

            <div class="page-hero__actions">
              <a href="/contact/" class="btn btn--primary">相談してみる</a>
              <LineButton />
            </div>
          </div>

          <figure class="page-hero__visual">
            <img
              src="/images/service-demolition-registration.jpg"
              alt="解体工事業者登録の申請書類"
              loading="eager"
            />
          </figure>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="conclusion-heading">
        <div class="section__inner section__inner--narrow">
          <div class="summary-box">
            <h2 id="conclusion-heading" class="summary-box__heading">まず結論</h2>
            <p class="summary-box__text">
              解体工事は、請負金額が小さくても、<strong>建設業許可か登録のどちらか</strong>がなければ請け負えません。
              最初に確かめるのは、<strong>お持ちの許可の業種</strong>と、<strong>工事をする都道府県</strong>、
              そして<strong>技術管理者を誰にするか</strong>の3点です。
              この3つが決まれば、登録の要否、申請先、費用の見通しが立ちます。
              当事務所では、技術管理者の証明方法を最初に整理し、着手前にお見積りをお出しします。
            </p>
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="target-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="target-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              こんな方にご利用いただいています
            </h2>
          </div>

          <ul class="check-list">
            {targetCases.map((item) => (
              <li class="check-list__item">{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="points-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="points-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              申請前に押さえたい3つのポイント
            </h2>
            <p class="section__sub">
              解体工事業の登録は、建設業許可とは別の法律・別の窓口です。出発点の違いを押さえておくと、後戻りが減ります。
            </p>
          </div>

          <div class="card-grid card-grid--three">
            {keyPoints.map((item) => (
              <article class="point-card">
                <span class="point-card__no">{item.no}</span>
                <h3 class="point-card__title">{item.title}</h3>
                <p class="point-card__text">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="license-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="license-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              許可と登録の関係
            </h2>
            <p class="section__sub">
              将来の事業規模によって、登録だけで進めるか、建設業許可を目指すかが変わります。
            </p>
          </div>

          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">お持ちの許可</th>
                  <th scope="col">解体工事業の登録</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">許可なし</th>
                  <td>必要です。請負金額が500万円未満でも必要です。</td>
                </tr>
                <tr>
                  <th scope="row">土木工事業・建築工事業・解体工事業のいずれか</th>
                  <td>不要です。</td>
                </tr>
                <tr>
                  <th scope="row">とび・土工工事業など、上記以外の許可</th>
                  <td>必要です。とび・土工工事業の許可だけでは、不要になりません。</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="attention-box" style="margin-top: 1.75rem;">
            <h3 class="attention-box__title">500万円以上の解体工事を請けるなら、建設業許可が必要です</h3>
            <p class="attention-box__text">
              登録で請けられるのは、500万円未満の解体工事です。500万円以上の工事を請ける予定がある場合は、
              解体工事業の建設業許可を目指すほうが、登録の手数料や更新の手間を重ねずに済むことがあります。
              許可を取ると登録は不要になるため、取得の順序もあわせてご相談ください。
            </p>
            <a href="/construction-permit/new/" class="text-link">建設業許可の新規申請を見る</a>
          </div>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="requirements-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="requirements-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              主な登録要件
            </h2>
            <p class="section__sub">
              建設業許可と違い、財産的基礎や経営管理体制の要件はありません。技術管理者の確認が中心になります。
            </p>
          </div>

          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">要件</th>
                  <th scope="col">内容</th>
                </tr>
              </thead>
              <tbody>
                {requirements.map((row) => (
                  <tr>
                    <th scope="row">{row.name}</th>
                    <td>{row.detail}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="engineer-heading">
        <div class="section__inner">
          <BasicContentVisual
            src="/images/requirement-management.jpg"
            alt="技術管理者の要件を確認するイメージ"
          >
            <div class="section__head-block">
              <h2 id="engineer-heading" class="section__heading">
                <span class="heading-icon" aria-hidden="true"></span>
                技術管理者は、どう証明するか
              </h2>
              <p class="section__sub">
                建設業許可の営業所技術者等とは別の基準です。同じ資格名でも、片方で認められたからもう片方も足りる、とは限りません。
              </p>
            </div>
          </BasicContentVisual>

          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">証明の方法</th>
                  <th scope="col">内容</th>
                </tr>
              </thead>
              <tbody>
                {engineerRoutes.map((row) => (
                  <tr>
                    <th scope="row">{row.name}</th>
                    <td>{row.detail}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="section__note">
            ※資格の種別や学歴の学科によって、必要な年数が変わります。詳しい基準は
            <a href="/blog/kaitai-gijutsu-kanrisha-shikaku-yoken/">解体工事業の技術管理者とは</a>をご覧ください。
          </p>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="docs-heading">
        <div class="section__inner">
          <BasicContentVisual
            src="/images/construction-documents.jpg"
            alt="解体工事業者登録に必要な書類一式"
            imageFirst={true}
          >
            <div class="section__head-block">
              <h2 id="docs-heading" class="section__heading">
                <span class="heading-icon" aria-hidden="true"></span>
                提出する主な書類
              </h2>
              <p class="section__sub">
                新規・更新、個人・法人、登録先の都道府県によって必要書類は異なります。代表的なものを挙げています。ご依頼後に、お客様ごとの必要書類一覧をお渡しします。
              </p>
            </div>
          </BasicContentVisual>

          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">書類</th>
                  <th scope="col">内容</th>
                </tr>
              </thead>
              <tbody>
                {documents.map((row) => (
                  <tr>
                    <th scope="row">{row.name}</th>
                    <td>{row.detail}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="flow-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="flow-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              ご依頼から登録までの流れ
            </h2>
            <p class="section__sub">
              技術管理者の証明方法が早く決まるほど、全体の期間は短くなります。
            </p>
          </div>

          <ol class="flow-list">
            {flowSteps.map((item) => (
              <li class="flow-step">
                <div class="flow-step__head">
                  <span class="flow-step__label">{item.step}</span>
                  <span class="flow-step__period">{item.period}</span>
                </div>
                <p class="flow-step__title">{item.title}</p>
                <p class="flow-step__text">{item.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="cost-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="cost-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              費用の目安
            </h2>
            <p class="section__sub">
              報酬額は税込表示です。1都道府県あたりの金額で、法定費用は大阪府・和歌山県の登録手数料です。
            </p>
          </div>

          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">手続</th>
                  <th scope="col" class="pattern-table__num-col">報酬（税込）</th>
                  <th scope="col" class="pattern-table__num-col">法定費用</th>
                </tr>
              </thead>
              <tbody>
                {costRows.map((row) => (
                  <tr>
                    <th scope="row">
                      {row.name}
                      <span class="pattern-table__note">{row.detail}</span>
                    </th>
                    <td class="pattern-table__num-col">{row.fee}</td>
                    <td class="pattern-table__num-col">{row.legal}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="section__note">
            ※表示額は、技術管理者を資格等で確認できる標準的な案件の目安です。実務経験の証明に追加の資料収集・確認が必要な場合は、着手前に別途お見積りします。
            ※大阪府と和歌山県の両方を登録する場合は、それぞれ1件分の報酬・法定費用がかかります。
            ※住民票・登記事項証明書などの証明書取得の実費、講習の受講料は別途です。
            正式な金額は内容をお伺いしたうえでお見積りします。
            詳細は<a href="/price/">料金案内</a>もご覧ください。
          </p>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="faq-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="faq-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              よくあるご質問
            </h2>
          </div>

          <div class="faq-list">
            {faqItems.map((item) => (
              <details class="faq-item">
                <summary class="faq-item__question">{item.q}</summary>
                <div class="faq-item__answer">
                  <p>{item.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="related-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="related-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              関連ページ
            </h2>
          </div>

          <div class="card-grid card-grid--three">
            {relatedLinks.map((item) => (
              <article class="info-card info-card--link">
                <h3 class="info-card__title">{item.title}</h3>
                <p class="info-card__text">{item.text}</p>
                <a href={item.href} class="text-link">ページを見る</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--contact-cta">
        <div class="section__inner">
          <div class="cta-box">
            <h2 class="cta-box__heading">登録が要るかどうかの確認から、お手伝いします。</h2>
            <p class="cta-box__text">
              お持ちの許可、工事をする都道府県、技術管理者の候補をお伺いし、必要な手続きと段取りをご案内します。
              大阪泉州・和歌山北部を中心に対応しています。
            </p>
            <div class="cta-box__actions">
              <a href="/contact/" class="btn btn--primary">お問い合わせフォームへ</a>
              <LineButton />
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
