---
import '../../styles/service-detail.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LineButton from '../../components/LineButton.astro';
import BasicContentVisual from '../../components/BasicContentVisual.astro';
import { pageTitle } from '../../config/site';

const targetCases = [
  '元請から「産廃の許可を取らないと現場の廃棄物を運べない」と言われた',
  '解体・リフォーム工事で出る廃棄物を、自社トラックで運搬したい',
  '建設業許可とあわせて、収集運搬の許可も整備したい',
  '許可の更新時期が近づいているが、書類の準備が進まない',
  '大阪と和歌山など、複数の都道府県で事業を行いたい',
  '積替え保管や処分業まで視野に入れているが、何から始めるべきか分からない',
];

const keyPoints = [
  {
    no: '01',
    title: '「どこで積んで、どこで下ろすか」で許可の数が決まる',
    text: '産業廃棄物収集運搬業の許可は、原則として都道府県（または政令市）ごとに必要です。大阪府の現場で積み、兵庫県の処分場へ運ぶ場合は、両方の許可が必要になります。事業エリアを最初に整理しないと、申請の範囲と費用の見通しがずれます。',
  },
  {
    no: '02',
    title: '講習の修了が、申請の前提になる',
    text: '新規申請では、日本産業廃棄物処理振興センターなどが実施する講習の修了が必要です。受講枠や日程に限りがあるため、許可が欲しい時期から逆算して申し込む必要があります。更新でも、一定の講習が求められることがあります。',
  },
  {
    no: '03',
    title: '車両・施設・経理の「実体」が審査される',
    text: '運搬車両の写真、駐車場の使用権限、事業計画、財務諸表など、机上の申請書だけでは足りません。特に積替え保管を含む場合は、施設基準と周辺環境への配慮が厳しく見られます。書類の不備で差し戻されると、許可までの期間が大きく延びます。',
  },
];

const permitTypes = [
  {
    name: '収集運搬業（積替え保管なし）',
    detail:
      '現場などで廃棄物を積み、処分場まで直接運ぶ場合の許可です。建設業者さまが最初に取得されることが多い区分です。',
  },
  {
    name: '収集運搬業（積替え保管あり）',
    detail:
      '途中で積み替えや一時保管を行う場合に必要です。施設の基準・周辺への影響が審査されるため、積替え保管なしより準備の幅が広がります。',
  },
  {
    name: '処分業（中間処理・最終処分）',
    detail:
      '破砕・選別・焼却などの処理、または最終処分を行う場合の許可です。施設設計と周辺対策が中心となり、収集運搬とは別の申請になります。',
  },
  {
    name: '特別管理産業廃棄物',
    detail:
      '廃石綿、感染性廃棄物など、特別な管理が必要な廃棄物を扱う場合の許可です。取扱う品目に応じて、追加の要件が課されます。',
  },
];

const requirements = [
  {
    name: '講習の修了',
    detail: '新規は原則として、指定の講習を修了した者が申請に関わります。更新でも講習が必要な場合があります。',
  },
  {
    name: '経理的基礎',
    detail: '事業を継続できる財務状態であることが求められます。直近の決算内容によっては、追加の説明資料が必要になることがあります。',
  },
  {
    name: '運搬施設（車両・駐車場）',
    detail: '運搬に使う車両と、その保管場所の使用権限を示す必要があります。写真や契約書で実体を確認されます。',
  },
  {
    name: '事業計画',
    detail: '扱う産業廃棄物の種類、収集運搬の方法、処分先との契約関係などを、計画として整理します。',
  },
  {
    name: '欠格要件に該当しないこと',
    detail: '役員等に一定の前歴等がないこと。法人の場合は、役員全員について確認が必要です。',
  },
];

const documents = [
  {
    name: '許可申請書・事業計画書',
    detail: '取扱う産業廃棄物の種類、運搬の経路・方法、処分先などを記載します。',
  },
  {
    name: '講習修了証の写し',
    detail: '新規申請では、原則として指定講習の修了証が必要です。',
  },
  {
    name: '登記事項証明書・定款（法人）',
    detail: '会社の基本情報と事業目的を確認します。目的に産業廃棄物関連の記載があるかも確認対象です。',
  },
  {
    name: '財務諸表・納税証明書',
    detail: '経理的基礎の確認に用います。個人の場合は確定申告書等になります。',
  },
  {
    name: '車両の書類・写真',
    detail: '車検証の写し、車両の前後左右の写真など。運搬に適した状態であることが求められます。',
  },
  {
    name: '駐車場の使用権限を示す書類',
    detail: '賃貸借契約書、使用承諾書、公図・案内図など。',
  },
  {
    name: '処分業者との契約書等',
    detail: '運び先が確保されていることを示す資料です。自治体によって添付の要否や書式が異なります。',
  },
];

const flowSteps = [
  {
    step: 'STEP 1',
    title: 'お問い合わせ・無料相談',
    period: '当日〜数日',
    text: '扱う廃棄物の種類、積む場所と下ろす場所、車両の有無、建設業許可との兼ね合いをお伺いします。「許可が必要かどうか分からない」段階でも構いません。',
  },
  {
    step: 'STEP 2',
    title: '許可区分と申請先の整理',
    period: '数日〜1週間',
    text: '積替え保管の有無、普通産廃か特別管理か、どの都道府県・政令市に申請するかを決めます。複数自治体が必要な場合は、同時進行の段取りも組みます。',
  },
  {
    step: 'STEP 3',
    title: '講習の日程確認・お見積り',
    period: '数日',
    text: '講習の空き状況を踏まえ、申請までのスケジュールと報酬・法定費用を明示したお見積りをご提示します。',
  },
  {
    step: 'STEP 4',
    title: '書類の収集・作成',
    period: '2〜4週間',
    text: '車両写真、駐車場の契約書、財務書類などをそろえ、申請書一式を作成します。当事務所で取得できる証明書は代理取得します。',
  },
  {
    step: 'STEP 5',
    title: '申請・審査・許可',
    period: 'おおむね1〜2か月',
    text: '管轄の窓口へ申請します。補正があれば対応し、許可証の交付までフォローします。取得後の更新時期についてもご案内します。',
  },
];

const costRows = [
  {
    name: '収集運搬業許可（新規）',
    detail: '積替え保管なし　1自治体',
    fee: '99,000円〜',
    legal: '81,000円',
  },
  {
    name: '収集運搬業許可（更新）',
    detail: '積替え保管なし　1自治体',
    fee: '77,000円〜',
    legal: '73,000円',
  },
  {
    name: '収集運搬業許可（変更）',
    detail: '事業範囲の変更等　1自治体',
    fee: '66,000円〜',
    legal: '71,000円',
  },
  {
    name: '2自治体目以降・積替え保管あり・処分業',
    detail: '内容により変動',
    fee: '要お見積り',
    legal: '別途',
  },
];

const constructionLinks = [
  {
    title: '建設現場の廃棄物を自社で運びたい',
    text: '解体ガラ、木くず、がれき類などを自社車両で運ぶ場合、建設業許可とは別に産廃の収集運搬許可が必要になることがあります。',
  },
  {
    title: '元請からの要請に応えたい',
    text: '現場入場や下請契約の条件として、産廃許可の提示を求められるケースが増えています。建設業許可と並行して整えると、受注の機会を逃しにくくなります。',
  },
  {
    title: '大阪と和歌山をまたいで動く',
    text: '泉州・和歌山北部のように県境をまたぐ事業者さまは、積む側と下ろす側の両方で許可が必要になることがあります。事業エリアの確認からご一緒します。',
  },
];

const faqItems = [
  {
    q: '建設業許可があれば、産廃の許可は不要ですか？',
    a: '原則として別の許可です。建設業許可は「建設工事を請け負う」ための許可で、産業廃棄物を業として収集・運搬するための許可ではありません。自社の工事から出た廃棄物でも、運搬を事業として行う形態によっては許可が必要です。判断に迷う場合は、具体的な運び方をお伺いして整理します。',
  },
  {
    q: '自社の現場から出たゴミを運ぶだけでも許可は必要ですか？',
    a: '排出事業者自らが運搬する場合など、許可が不要なケースもあります。一方、他社の廃棄物を運ぶ、運搬を請け負う、といった形になると許可が必要です。契約関係と実態の両方を見て判断しますので、「自社だけ」と思っていても一度確認することをおすすめします。',
  },
  {
    q: '大阪府と和歌山県、両方の許可が必要ですか？',
    a: '積む場所と下ろす場所が異なる都道府県（または政令市）にある場合は、原則として両方の許可が必要です。泉州で積んで和歌山の処分場へ運ぶ、といったパターンでは、申請先が複数になります。必要な自治体を先に洗い出します。',
  },
  {
    q: '許可が下りるまで、どのくらいかかりますか？',
    a: '講習の日程と書類のそろい具合によりますが、ご相談から許可までおおむね2〜3か月を見込むことが多いです。審査自体は自治体によって異なりますが、それ以前の講習受講と資料収集に時間がかかることが多いです。',
  },
  {
    q: '許可の有効期限はありますか？',
    a: '原則5年です。更新を受けないと効力を失います。更新には講習や書類の準備が必要なため、期限の半年前には着手することをおすすめします。',
  },
  {
    q: '積替え保管なしで始めて、後から保管ありに変更できますか？',
    a: '可能です。ただし積替え保管ありは施設基準の確認が加わるため、変更許可として改めて審査を受けます。まずは積替え保管なしで事業を始め、必要になった段階で拡張する進め方もよくあります。',
  },
];

const relatedLinks = [
  {
    title: '建設業許可 新規申請',
    text: '建設業許可と産廃許可をあわせて整備したい場合の流れをご案内します。',
    href: '/construction-permit/new',
  },
  {
    title: '会社設立サポート',
    text: '法人成りとあわせて産廃許可を取得する場合、定款の目的記載も重要です。',
    href: '/service/company-setup',
  },
  {
    title: '料金案内',
    text: '産廃許可以外の手続の費用目安も一覧で確認できます。',
    href: '/price',
  },
];
---

<BaseLayout
  title={pageTitle('産業廃棄物収集運搬業許可（産廃許可）のサポート')}
  description="大阪泉州・和歌山北部の産業廃棄物収集運搬業許可をサポート。建設業者さまの現場廃棄物の運搬、新規・更新・変更、複数自治体申請まで。要件確認から書類作成、申請まで丁寧にご案内します。"
  breadcrumbs={[
    { name: 'ホーム', href: '/' },
    { name: '業務案内', href: '/service/' },
    { name: '産廃許可' },
  ]}
>
  <div class="page">
    <SiteHeader />

    <main>
      <section class="page-hero section--base" aria-labelledby="page-heading">
        <div class="page-hero__inner">
          <nav class="breadcrumb" aria-label="パンくずリスト">
            <ol>
              <li><a href="/">ホーム</a></li>
              <li><a href="/service/">業務案内</a></li>
              <li aria-current="page">産廃許可</li>
            </ol>
          </nav>

          <div class="page-hero__content">
            <p class="page-hero__label">SERVICE</p>
            <h1 id="page-heading" class="page-hero__title">
              産業廃棄物収集運搬業許可<br />（産廃許可）のサポート
            </h1>
            <p class="page-hero__lead">
              建設現場や工場から出る産業廃棄物を<strong>業として運搬する</strong>には、
              廃棄物処理法に基づく許可が必要です。
              やちよ行政書士事務所では、大阪泉州・和歌山北部の事業者さまの産廃許可をサポートします。
            </p>
            <p class="page-hero__note">
              「元請から取れと言われた」「自社で運んでよいのか分からない」という段階からご相談いただけます。
            </p>

            <div class="page-hero__actions">
              <a href="/contact" class="btn btn--primary">相談してみる</a>
              <LineButton />
            </div>
          </div>

          <figure class="page-hero__visual">
            <img
              src="/images/other-permits-procedures.jpg"
              alt="産業廃棄物収集運搬業許可の申請書類"
              loading="eager"
            />
          </figure>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="conclusion-heading">
        <div class="section__inner section__inner--narrow">
          <div class="summary-box">
            <h2 id="conclusion-heading" class="summary-box__heading">まず結論</h2>
            <p class="summary-box__text">
              産廃許可で最初に固めるべきなのは、申請書の書き方ではなく、
              <strong>「何を、どこからどこへ、誰が運ぶか」</strong>です。
              ここが決まれば、必要な許可の種類、申請先の自治体、講習の時期、費用の目安が揃います。
              逆に、ここが曖昧なまま走り出すと、書類の作り直しや申請先の追加が発生します。
              当事務所では、建設業の現場実態も踏まえて、最初の見通しづくりに時間をかけます。
            </p>
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="target-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="target-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              こんな方にご利用いただいています
            </h2>
          </div>

          <ul class="check-list">
            {targetCases.map((item) => (
              <li class="check-list__item">{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="points-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="points-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              申請前につまずきやすい3つのポイント
            </h2>
            <p class="section__sub">
              産廃許可は、建設業許可とは別の法律・別の窓口です。準備の出発点が違うことを押さえておくと、後戻りが減ります。
            </p>
          </div>

          <div class="card-grid card-grid--three">
            {keyPoints.map((item) => (
              <article class="point-card">
                <span class="point-card__no">{item.no}</span>
                <h3 class="point-card__title">{item.title}</h3>
                <p class="point-card__text">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="types-heading">
        <div class="section__inner">
          <BasicContentVisual
            src="/images/application-types.jpg"
            alt="産廃許可の区分を整理するイメージ"
          >
            <div class="section__head-block">
              <h2 id="types-heading" class="section__heading">
                <span class="heading-icon" aria-hidden="true"></span>
                最初に決めるのは「どの許可が必要か」
              </h2>
              <p class="section__sub">
                産廃の許可は一種類ではありません。運搬だけか、保管や処分まで含むかで、そろえる書類も審査の厳しさも変わります。
              </p>
            </div>
          </BasicContentVisual>

          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">区分</th>
                  <th scope="col">内容</th>
                </tr>
              </thead>
              <tbody>
                {permitTypes.map((row) => (
                  <tr>
                    <th scope="row">{row.name}</th>
                    <td>{row.detail}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="construction-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="construction-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              建設業許可との関係
            </h2>
            <p class="section__sub">
              建設業者さまからのご相談が多く、現場の廃棄物を自社で運ぶ場合などに必要になることが多い手続です。
            </p>
          </div>

          <div class="card-grid card-grid--three">
            {constructionLinks.map((item) => (
              <article class="info-card">
                <h3 class="info-card__title">{item.title}</h3>
                <p class="info-card__text">{item.text}</p>
              </article>
            ))}
          </div>

          <div class="attention-box" style="margin-top: 1.75rem;">
            <h3 class="attention-box__title">建設業許可と同時に進めると、無駄が減ります</h3>
            <p class="attention-box__text">
              法人の定款目的、役員構成、財務書類などは、建設業許可と産廃許可で共通して使う部分があります。
              別々に進めると、同じ資料を二度集めることになります。
              いま建設業許可を検討中の方は、産廃の要否もあわせてご相談ください。
            </p>
            <a href="/construction-permit/new" class="text-link">建設業許可の新規申請を見る</a>
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="requirements-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="requirements-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              主な許可要件
            </h2>
            <p class="section__sub">
              自治体によって細部は異なります。ここでは、積替え保管なしの収集運搬でよく確認される点を挙げています。
            </p>
          </div>

          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">要件</th>
                  <th scope="col">内容</th>
                </tr>
              </thead>
              <tbody>
                {requirements.map((row) => (
                  <tr>
                    <th scope="row">{row.name}</th>
                    <td>{row.detail}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="docs-heading">
        <div class="section__inner">
          <BasicContentVisual
            src="/images/construction-documents.jpg"
            alt="産廃許可申請に必要な書類一式"
            imageFirst={true}
          >
            <div class="section__head-block">
              <h2 id="docs-heading" class="section__heading">
                <span class="heading-icon" aria-hidden="true"></span>
                提出する主な書類
              </h2>
              <p class="section__sub">
                新規・更新・変更、個人・法人、自治体の別によって必要書類は異なります。代表的なものを挙げています。
              </p>
            </div>
          </BasicContentVisual>

          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">書類</th>
                  <th scope="col">内容</th>
                </tr>
              </thead>
              <tbody>
                {documents.map((row) => (
                  <tr>
                    <th scope="row">{row.name}</th>
                    <td>{row.detail}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="flow-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="flow-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              ご依頼から許可取得までの流れ
            </h2>
            <p class="section__sub">
              講習の日程が取れるかどうかで、全体の期間は大きく変わります。許可が必要な時期から逆算して進めます。
            </p>
          </div>

          <ol class="flow-list">
            {flowSteps.map((item) => (
              <li class="flow-step">
                <div class="flow-step__head">
                  <span class="flow-step__label">{item.step}</span>
                  <span class="flow-step__period">{item.period}</span>
                </div>
                <p class="flow-step__title">{item.title}</p>
                <p class="flow-step__text">{item.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="cost-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="cost-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              費用の目安
            </h2>
            <p class="section__sub">
              報酬額は税込表示です。法定費用は自治体により異なる場合があり、下表は大阪府の収集運搬（積替え保管なし）を目安にしています。
            </p>
          </div>

          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">手続</th>
                  <th scope="col" class="pattern-table__num-col">報酬（税込）</th>
                  <th scope="col" class="pattern-table__num-col">法定費用</th>
                </tr>
              </thead>
              <tbody>
                {costRows.map((row) => (
                  <tr>
                    <th scope="row">
                      {row.name}
                      <span class="pattern-table__note">{row.detail}</span>
                    </th>
                    <td class="pattern-table__num-col">{row.fee}</td>
                    <td class="pattern-table__num-col">{row.legal}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="section__note">
            ※講習受講料、証明書取得の実費、2自治体目以降の申請は別途です。
            正式な金額は内容をお伺いしたうえでお見積りします。
            詳細は<a href="/price">料金案内</a>もご覧ください。
          </p>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="faq-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="faq-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              よくあるご質問
            </h2>
          </div>

          <div class="faq-list">
            {faqItems.map((item) => (
              <details class="faq-item">
                <summary class="faq-item__question">{item.q}</summary>
                <div class="faq-item__answer">
                  <p>{item.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="related-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="related-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              関連ページ
            </h2>
          </div>

          <div class="card-grid card-grid--three">
            {relatedLinks.map((item) => (
              <article class="info-card info-card--link">
                <h3 class="info-card__title">{item.title}</h3>
                <p class="info-card__text">{item.text}</p>
                <a href={item.href} class="text-link">ページを見る</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--contact-cta">
        <div class="section__inner">
          <div class="cta-box">
            <h2 class="cta-box__heading">運ぶ場所が分かれば、許可の見通しが立ちます。</h2>
            <p class="cta-box__text">
              扱う廃棄物、積む場所と下ろす場所、車両の有無をお伺いし、必要な許可と段取りをご案内します。
              大阪泉州・和歌山北部を中心に対応しています。
            </p>
            <div class="cta-box__actions">
              <a href="/contact" class="btn btn--primary">お問い合わせフォームへ</a>
              <LineButton />
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
