---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LineButton from '../components/LineButton.astro';
import { pageTitle, OFFICE_ADDRESS, OFFICE_GOOGLE_MAPS_URL, OFFICE_GOOGLE_MAPS_EMBED_URL } from '../config/site';

const strengths = [
  {
    title: '建設業許可と継続手続を重視',
    text: '新規申請だけでなく、更新、決算変更届、業種追加など、許可取得後の継続手続まで見据えたサポートを大切にしています。',
  },
  {
    title: '泉州・和歌山北部をまたぐ地域対応',
    text: '阪南市の立地を活かし、大阪泉州と和歌山北部の両地域を視野に入れた対応を目指しています。',
  },
  {
    title: 'わかりやすく、相談しやすく',
    text: '初めて手続を検討される方にも分かりやすい説明を心がけ、必要な確認事項や進め方を整理してご案内します。',
  },
];
---

<BaseLayout
  title={pageTitle('事務所概要・代表者紹介')}
  description="阪南市拠点のやちよ行政書士事務所。泉州・和歌山北部を中心に、建設業許可と継続手続を重視。初めて許可を検討する事業者さまにもわかりやすくご案内します。"
  breadcrumbs={[
    { name: 'ホーム', href: '/' },
    { name: '事務所概要・代表者紹介' },
  ]}
>
  <div class="page">
    <SiteHeader />

    <main>
      <section class="page-hero section--base">
        <div class="page-hero__inner">
          <nav class="breadcrumb" aria-label="パンくずリスト">
            <ol>
              <li><a href="/">ホーム</a></li>
              <li aria-current="page">事務所概要・代表者紹介</li>
            </ol>
          </nav>

          <div class="page-hero__content">
            <p class="page-hero__label">ABOUT</p>
            <h1 class="page-hero__title">事務所概要・代表者紹介</h1>
            <p class="page-hero__lead">
              やちよ行政書士事務所は、大阪府阪南市を拠点に、
              大阪泉州・和歌山北部の事業者さまや地域の皆さまに寄り添う行政書士事務所を目指しています。
            </p>
          </div>

          <figure class="page-hero__visual">
            <img src="/images/about-office.jpg" alt="事務所紹介イメージ" loading="eager" />
          </figure>
        </div>
      </section>

      <section class="section section--base">
        <div class="section__inner section__grid">
          <div class="section__intro">
            <h2 class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              事務所の考え方
            </h2>
          </div>
          <div class="section__body">
            <p class="section__lead">
              建設業許可は、取ることそのものより、取った後にどう維持し、どう事業につなげていくかが大切だと考えています。
            </p>
            <p class="section__text">
              そのため当事務所では、建設業許可の新規申請だけでなく、更新、決算変更届、業種追加などの継続手続も重視しています。
              「とりあえず申請する」のではなく、今後の流れまで見通しやすいサポートを心がけています。
            </p>
          </div>
        </div>
      </section>

      <section class="section section--band">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              当事務所の特徴
            </h2>
          </div>

          <div class="strength-list">
            {strengths.map((item) => (
              <article class="strength-card">
                <h3 class="strength-card__title">{item.title}</h3>
                <p class="strength-card__text">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--base">
        <div class="section__inner section__grid">
          <div class="section__intro">
            <h2 class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              代表者より
            </h2>
          </div>
          <div class="section__body">
            <p class="section__text">
              はじめまして。やちよ行政書士事務所の代表、鹿野正幸（しかの まさゆき）です。
            </p>
            <p class="section__text">
              行政手続は、制度の内容そのものだけでなく、「自分の状況では何を確認すべきか」が分かりにくいことが少なくありません。
              特に建設業許可は、新規申請だけでなく、その後の更新や決算変更届など継続的な管理も重要です。
            </p>
            <p class="section__text">
              当事務所では、大阪泉州・和歌山北部の地域性を踏まえながら、身近で相談しやすい窓口を目指しています。
              初めてご相談される方にも分かりやすく、落ち着いて進められるよう丁寧なご案内を心がけてまいります。
            </p>
          </div>
        </div>
      </section>

      <section class="section section--band">
        <div class="section__inner section__grid">
          <div class="section__intro">
            <h2 class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              事務所概要
            </h2>
          </div>
          <div class="section__body">
            <dl class="office-info">
              <div class="office-info__row">
                <dt>事務所名</dt>
                <dd>やちよ行政書士事務所</dd>
              </div>
              <div class="office-info__row">
                <dt>代表者</dt>
                <dd>鹿野 正幸（しかの まさゆき）</dd>
              </div>
              <div class="office-info__row">
                <dt>所在地</dt>
                <dd>{OFFICE_ADDRESS.full}</dd>
              </div>
              <div class="office-info__row">
                <dt>対応エリア</dt>
                <dd>大阪泉州・和歌山北部を中心に対応</dd>
              </div>
              <div class="office-info__row">
                <dt>主な取扱業務</dt>
                <dd>建設業許可、新規申請、更新、決算変更届、業種追加、その他許認可・法人関連手続</dd>
              </div>
              <div class="office-info__row">
                <dt>ご相談時間</dt>
                <dd>平日 18:30〜21:00　土日 9:00〜18:00</dd>
              </div>
              <div class="office-info__row">
                <dt>ご相談方法</dt>
                <dd>
                  オンライン・対面のいずれも可能（事前予約制）<br />
                  対面は原則事務所外（オンライン／ご指定場所）。平日夜・土日の対面も承ります<br />
                  事務所へのご来訪をご希望の場合も、事前予約にて対応します
                </dd>
              </div>
              <div class="office-info__row">
                <dt>お問い合わせ</dt>
                <dd>お問い合わせフォーム・公式LINEより24時間受付（返信はご相談時間内を目安）</dd>
              </div>
            </dl>

            <div class="office-map">
              <p class="office-map__note">
                ※ 事務所へのご来訪は<strong>事前予約制</strong>です。対面のご相談は、原則事務所外でも承ります。
              </p>
              <div class="office-map__embed">
                <iframe
                  src={OFFICE_GOOGLE_MAPS_EMBED_URL}
                  title="やちよ行政書士事務所の地図（大阪府阪南市自然田753-14）"
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                ></iframe>
              </div>
              <p class="office-map__link-wrap">
                <a
                  href={OFFICE_GOOGLE_MAPS_URL}
                  class="office-map__link"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Googleマップで開く
                </a>
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="section section--contact-cta">
        <div class="section__inner">
          <div class="cta-box">
            <h2 class="cta-box__heading">まずは現在の状況整理から、お気軽にご相談ください。</h2>
            <p class="cta-box__text">
              建設業許可が必要かどうか分からない段階でも構いません。必要な手続の方向性を一緒に整理します。
            </p>
            <div class="cta-box__actions">
              <a href="/contact" class="btn btn--primary">お問い合わせフォームへ</a>
              <LineButton />
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .page { min-height: 100vh; display: flex; flex-direction: column; background: #fff; }
  .section--base { background: #fff; }
  .section--band { background: #f8fafc; border-block: 1px solid var(--color-border); }
  .section { padding: var(--space-section-y) var(--space-section-x); }
  .section__inner { max-width: var(--content-max); margin: 0 auto; }
  .section__head-block { margin-bottom: 2rem; }

  .page-hero { padding: clamp(3.25rem, 9vw, 5.75rem) var(--space-section-x) max(var(--space-section-y), 3.75rem); }
  .page-hero__inner { max-width: var(--content-max); margin: 0 auto; display: grid; gap: 2rem 2.5rem; align-items: center; }
  @media (min-width: 960px) {
    .page-hero__inner { grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr); }
  }
  .breadcrumb { grid-column: 1 / -1; }
  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    list-style: none;
    margin: 0 0 0.25rem;
    padding: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
  .breadcrumb li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: var(--color-border-strong);
  }
  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-primary);
  }
  .breadcrumb li[aria-current='page'] {
    color: var(--color-text);
    font-weight: 600;
  }
  .page-hero__label { margin: 0 0 1rem; font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.16em; color: var(--color-primary); }
  .page-hero__title { margin: 0 0 1.25rem; font-size: clamp(1.8rem, 6vw, 2.75rem); line-height: 1.35; color: var(--color-text); }
  .page-hero__lead { margin: 0; font-size: 1rem; line-height: 1.95; color: var(--color-text-muted); max-width: 44rem; }
  .page-hero__visual { margin: 0; border-radius: 1rem; overflow: hidden; border: 1px solid var(--color-border); box-shadow: var(--shadow-md); }
  .page-hero__visual img { display: block; width: 100%; height: 100%; min-height: 260px; object-fit: cover; }

  .heading-icon { display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; border-radius: 0.4rem; background: #1e3a8a; flex-shrink: 0; margin-right: 0.65rem; }
  .heading-icon::after { content: ''; width: 0.55rem; height: 0.72rem; border: 2px solid #fff; border-radius: 2px; }
  .section__heading { display: flex; align-items: center; flex-wrap: wrap; margin: 0 0 1rem; font-size: clamp(1.2rem, 2.8vw, 1.45rem); font-weight: 700; color: var(--color-primary); line-height: 1.4; }
  .section__grid { display: grid; gap: 1.75rem 2.75rem; }
  @media (min-width: 768px) {
    .section__grid { grid-template-columns: minmax(11rem, 15rem) 1fr; align-items: start; }
  }
  .section__lead { margin: 0 0 1rem; font-size: 1.0625rem; font-weight: 600; line-height: 1.85; color: var(--color-text); }
  .section__text { margin: 0 0 1rem; font-size: 0.9375rem; line-height: 1.9; color: var(--color-text-muted); }

  .strength-list { display: grid; gap: 1.25rem; }
  @media (min-width: 768px) { .strength-list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .strength-card { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-sm); }
  .strength-card__title { margin: 0 0 0.75rem; font-size: 1rem; font-weight: 700; color: var(--color-text); }
  .strength-card__text { margin: 0; line-height: 1.85; color: var(--color-text-muted); }

  .office-info { margin: 0; }
  .office-info__row { display: grid; grid-template-columns: 8rem 1fr; gap: 0.75rem 1rem; padding: 0.9rem 0; border-bottom: 1px solid var(--color-border); }
  .office-info__row:first-child { border-top: 1px solid var(--color-border); }
  .office-info__row dt { font-weight: 700; color: var(--color-text-muted); }
  .office-info__row dd { margin: 0; color: var(--color-text); line-height: 1.8; }

  .office-map { margin-top: 2rem; }
  .office-map__note {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    line-height: 1.85;
    color: var(--color-text-muted);
  }
  .office-map__note strong { color: var(--color-text); font-weight: 700; }
  .office-map__embed {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    background: #f3f6fb;
    aspect-ratio: 16 / 10;
  }
  .office-map__embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .office-map__link-wrap { margin: 0.85rem 0 0; text-align: right; }
  .office-map__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }
  .office-map__link::after { content: '↗'; font-size: 0.85em; }
  .office-map__link:hover { text-decoration: underline; }

  .section--contact-cta { background: #fff; padding: var(--space-section-y) var(--space-section-x) max(var(--space-section-y), 4rem); }
  .cta-box { background: #f8fafc; border: 1px solid var(--color-border); border-radius: 1rem; padding: clamp(1.75rem, 4vw, 2.5rem); box-shadow: var(--shadow-md); text-align: center; }
  .cta-box__heading { margin: 0 0 1rem; font-size: clamp(1.2rem, 2.8vw, 1.6rem); line-height: 1.6; color: var(--color-text); }
  .cta-box__text { margin: 0 0 1.5rem; color: var(--color-text-muted); line-height: 1.9; }
  .cta-box__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem 1rem; }

  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0 1.5rem; font-size: 0.9375rem; font-weight: 700; border-radius: var(--radius); text-decoration: none; }
  .btn--primary { background: #1e3a8a; color: #fff; border: 2px solid #1e3a8a; }
</style>
