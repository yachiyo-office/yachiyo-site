---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LineButton from '../../components/LineButton.astro';
import { pageTitle } from '../../config/site';

const concerns = [
  '元請先や取引先から建設業許可の取得を求められている',
  '500万円以上の工事を請けたいが、許可が必要か判断に迷っている',
  '自社が要件を満たしているのか分からない',
  '更新や決算変更届など、許可取得後の手続にも不安がある',
  '今後、業種追加や法人成りも視野に入れている',
  '泉州・和歌山北部で継続して相談できる行政書士を探している',
];

const supports: { title: string; text: string; href?: string }[] = [
  {
    title: '建設業許可 新規申請',
    text: '初めて建設業許可を取得したい方向けのサポートです。許可が必要になるかどうかの整理から、申請区分、要件確認、必要資料の見通しまで、最初の段階でつまずきやすい点を分かりやすくご案内します。',
    href: '/construction-permit/new',
  },
  {
    title: '建設業許可 更新申請',
    text: '建設業許可は5年ごとの更新が必要です。更新時に慌てないよう、これまでの届出状況や必要な確認事項を整理し、更新に向けた準備を進めやすくします。',
    href: '/construction-permit/renewal',
  },
  {
    title: '決算変更届',
    text: '決算変更届は、建設業許可を維持していくうえで毎年重要となる手続です。更新や業種追加、将来的な経審にも関わるため、後回しにせず継続して管理することが大切です。',
    href: '/construction-permit/annual-report',
  },
  {
    title: '業種追加・各種変更届',
    text: '事業拡大や体制変更に伴い、業種追加や役員変更、営業所変更などの届出が必要になることがあります。変更内容に応じて、何を確認し、どのように進めるべきかを整理してご案内します。',
    href: '/construction-permit/changes',
  },
  {
    title: '将来的な経審・入札の準備',
    text: '公共工事を視野に入れる場合は、日頃の許可管理や決算変更届の積み重ねが重要になります。今すぐの申請でなくても、将来を見据えた準備の方向性を早めに確認しておくことが役立ちます。',
    href: '/construction-permit/keishin',
  },
  {
    title: '事業承継（相続・法人成り）',
    text: '許可は相続や会社設立では自動的に引き継がれません。認可により残存期間や業種を承継できる場合があります。期限の確認からご案内します。',
    href: '/construction-permit/succession',
  },
];

const strengths = [
  {
    title: '新規申請だけでなく継続手続まで見据える',
    text: '建設業許可は取得して終わりではありません。更新、決算変更届、各種変更届など、その後の維持管理まで視野に入れてご案内します。',
  },
  {
    title: '阪南市拠点で泉州・和歌山北部に対応',
    text: '阪南市を拠点に、大阪泉州・和歌山北部の事業者さまにとって相談しやすい身近な窓口を目指しています。',
  },
  {
    title: '初めての方にも分かりやすく整理',
    text: '専門用語を並べるだけでなく、今どの段階にあり、何を確認すべきか、次に何を進めればよいかを順序立ててご説明します。',
  },
];

const flowSteps = [
  {
    step: 'STEP 1',
    title: 'お問い合わせ',
    text: 'お電話や公式LINEにてご要件の概要をお伺いします。建設業許可が必要かどうか分からない段階でもお気軽にご相談ください。',
  },
  {
    step: 'STEP 2',
    title: '面談・ヒアリング（現状整理）',
    text: '現在の事業内容や今後のご予定を確認し、必要な手続やスケジュール、進行順序を分かりやすく整理してご説明します。',
  },
  {
    step: 'STEP 3',
    title: 'ご提案・お見積り',
    text: '対応内容と費用の目安を明確にご提示します。ご納得いただいてから着手しますので、安心してご検討いただけます。',
  },
  {
    step: 'STEP 4',
    title: '受任・手続遂行',
    text: '必要書類の収集・作成から申請・提出まで、内容に応じて迅速にサポートします。許可取得後に必要となる継続手続についても見据えてご案内します。',
  },
];

const areas = [
  '阪南市',
  '岸和田市',
  '和泉市',
  '泉佐野市',
  '泉南市',
  '貝塚市',
  '泉大津市',
  '熊取町',
  '田尻町',
  '忠岡町',
  '岬町',
  '和歌山市',
  '岩出市',
  '紀の川市',
];

const faqs = [
  {
    q: 'まだ建設業許可が必要かどうか分からないのですが相談できますか？',
    a: 'はい。工事内容や請負金額、今後の事業方針などを整理し、まず許可の必要性を確認するところからご案内します。',
  },
  {
    q: '個人事業主でも建設業許可を取ることはできますか？',
    a: 'はい。要件を満たせば個人事業主でも建設業許可を取得できる場合があります。現在の事業内容や体制を確認しながら整理します。',
  },
  {
    q: '許可を取った後も手続はありますか？',
    a: 'あります。毎年の決算変更届、5年ごとの更新、役員や営業所などに変更があった場合の各種届出など、継続して必要となる手続があります。',
  },
  {
    q: '更新や決算変更届だけでも相談できますか？',
    a: 'はい。新規申請だけでなく、更新、決算変更届、業種追加、各種変更届など、許可取得後の継続手続についてもご相談いただけます。',
  },
  {
    q: '大阪泉州以外や和歌山北部以外からでも相談できますか？',
    a: '内容に応じて対応可能な場合があります。まずは現在の状況とご希望をお聞かせください。',
  },
];
---

<BaseLayout
  title={pageTitle('建設業許可（新規・更新・決算変更届）')}
  description="阪南市を拠点に、大阪泉州・和歌山北部の建設業許可をサポート。新規申請、更新、決算変更届、業種追加、各種変更届まで、許可取得後の継続手続も見据えてご案内します。"
  breadcrumbs={[{ name: 'ホーム', href: '/' }, { name: '建設業許可' }]}
>
  <div class="page">
    <SiteHeader />

    <main>
      <section class="page-hero section--base" aria-labelledby="page-heading">
        <div class="page-hero__inner">
          <nav class="breadcrumb" aria-label="パンくずリスト">
            <ol>
              <li><a href="/">ホーム</a></li>
              <li aria-current="page">建設業許可</li>
            </ol>
          </nav>

          <div class="page-hero__content">
            <p class="page-hero__label">SERVICE</p>
            <h1 id="page-heading" class="page-hero__title">
              大阪泉州・和歌山北部で<br />
              建設業許可の取得・更新・決算変更届をご検討の方へ
            </h1>
            <p class="page-hero__lead">
              建設業許可は、一定の場合に必要となる重要な許可です。
              もっとも、実際には「自社に許可が必要なのか」「要件を満たしているのか」「どの資料をそろえればよいのか」で止まってしまうことも少なくありません。
              やちよ行政書士事務所では、大阪泉州・和歌山北部の事業者さまを中心に、建設業許可の新規申請、更新、決算変更届、業種追加、各種変更届まで、許可取得後の継続手続も見据えて丁寧にご案内します。
            </p>
            <div class="page-hero__actions">
              <a href="/contact" class="btn btn--primary">お問い合わせ</a>
              <LineButton />
            </div>
          </div>

          <figure class="page-hero__visual">
            <img
              src="/images/construction-permit-main.jpg"
              alt="建設業許可サポートをイメージする建設現場"
              loading="eager"
            />
          </figure>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="concerns-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="concerns-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              こんなお悩みはありませんか
            </h2>
          </div>

          <ul class="concern-list">
            {concerns.map((item) => (
              <li class="concern-item">{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="overview-heading">
        <div class="section__inner section__grid section__grid--visual">
          <div class="section__main">
            <h2 id="overview-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              建設業許可は取得後の管理まで見据えることが大切です
            </h2>
            <p class="section__lead">
              建設業許可は、取得できるかどうかだけでなく、その後も適切に維持していけるかが重要です。
            </p>
            <p class="section__text">
              許可取得後には、毎年の決算変更届、5年ごとの更新、役員や営業所の変更に伴う各種届出、業種追加など、継続して確認すべき手続があります。
              そのため、建設業許可を考える際には「今、許可が取れるか」だけでなく、「取得後の管理まで無理なく続けられるか」という視点で準備することが大切です。
            </p>
          </div>

          <figure class="section__visual">
            <img
              src="/images/construction-documents.jpg"
              alt="建設業許可取得後の継続手続をイメージする書類と図面"
              loading="lazy"
            />
          </figure>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="basic-guide-heading">
        <div class="section__inner">
          <div class="knowledge-box">
            <div class="knowledge-box__content">
              <p class="knowledge-box__label">BASIC GUIDE</p>
              <h2 id="basic-guide-heading" class="knowledge-box__heading">
                まず制度の全体像を知りたい方へ
              </h2>
              <p class="knowledge-box__text">
                「そもそも建設業許可が必要になるのはどんな場合か」「知事許可・大臣許可や一般建設業・特定建設業の違いは何か」「主な許可要件はどこを見ればよいか」など、
                まず基本から整理したい方向けに、基礎知識ページをご用意しています。
              </p>
            </div>
            <div class="knowledge-box__actions">
              <a href="/construction-permit/basic/" class="btn btn--secondary">
                建設業許可の基礎知識を見る
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="support-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="support-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              主なサポート内容
            </h2>
          </div>

          <div class="support-list">
            {supports.map((item) => (
              <article class="support-card">
                <h3 class="support-card__title">{item.title}</h3>
                <p class="support-card__text">{item.text}</p>
                {item.href && (
                  <a href={item.href} class="support-card__link">詳しいご案内を見る</a>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="strength-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="strength-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              やちよ行政書士事務所の特徴
            </h2>
          </div>

          <div class="strength-list">
            {strengths.map((item) => (
              <article class="strength-card">
                <h3 class="strength-card__title">{item.title}</h3>
                <p class="strength-card__text">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="flow-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="flow-heading" class="section__heading section__heading--center">
              <span class="heading-icon" aria-hidden="true"></span>
              ご相談の流れ
            </h2>
          </div>

          <figure class="flow-visual">
            <img
              src="/images/consultation.jpg"
              alt="建設業許可の相談・ヒアリングのイメージ"
              loading="lazy"
            />
          </figure>

          <ol class="flow-list">
            {flowSteps.map((item) => (
              <li class="flow-step">
                <span class="flow-step__label">{item.step}</span>
                <p class="flow-step__title">{item.title}</p>
                <p class="flow-step__text">{item.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="area-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="area-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              対応エリア
            </h2>
            <p class="section__sub">
              阪南市を拠点に、大阪泉州・和歌山北部を中心に対応しています。下記以外の地域も内容に応じてご案内します。
            </p>
          </div>

          <ul class="area-list">
            {areas.map((area) => (
              <li class="area-item">{area}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="faq-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="faq-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              よくあるご質問
            </h2>
          </div>

          <div class="faq-list">
            {faqs.map((item) => (
              <details class="faq-item">
                <summary class="faq-item__question">{item.q}</summary>
                <div class="faq-item__answer">
                  <p>{item.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--contact-cta">
        <div class="section__inner">
          <div class="cta-box">
            <h2 class="cta-box__heading">
              建設業許可が必要かどうか分からない段階でも、お気軽にご相談ください。
            </h2>
            <p class="cta-box__text">
              新規申請、更新、決算変更届、業種追加など、現在の状況を整理しながら必要な手続の方向性をご案内します。
            </p>

            <div class="cta-box__actions">
              <a href="/contact" class="btn btn--primary">お問い合わせフォームへ</a>
              <LineButton />
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #ffffff;
  }

  .section--base {
    background: #ffffff;
  }

  .section--band {
    background: #f8fafc;
    border-block: 1px solid var(--color-border);
  }

  .section {
    padding: var(--space-section-y) var(--space-section-x);
  }

  .section__inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .section__inner--narrow {
    max-width: 52rem;
  }

  .section__head-block {
    margin-bottom: 2rem;
  }

  .heading-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.4rem;
    background: #1e3a8a;
    flex-shrink: 0;
    vertical-align: middle;
    margin-right: 0.65rem;
  }

  .heading-icon::after {
    content: '';
    width: 0.55rem;
    height: 0.72rem;
    border: 2px solid #fff;
    border-radius: 2px;
  }

  .section__heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    margin: 0 0 1rem;
    font-size: clamp(1.2rem, 2.8vw, 1.45rem);
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.05em;
    line-height: 1.4;
  }

  .section__heading--center {
    justify-content: center;
    text-align: center;
  }

  .section__sub {
    margin: 0;
    max-width: 44rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.85;
  }

  .section__lead {
    margin: 0 0 1rem;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.85;
    color: var(--color-text);
  }

  .section__text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.9;
    color: var(--color-text-muted);
  }

  .page-hero {
    padding: clamp(3.25rem, 9vw, 5.75rem) var(--space-section-x)
      max(var(--space-section-y), 3.75rem);
  }

  .page-hero__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    gap: 2rem 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .page-hero__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    }
  }

  .breadcrumb {
    grid-column: 1 / -1;
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    list-style: none;
    margin: 0 0 0.25rem;
    padding: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .breadcrumb li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: var(--color-border-strong);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-primary);
  }

  .breadcrumb li[aria-current='page'] {
    color: var(--color-text);
    font-weight: 600;
  }

  .page-hero__label {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--color-primary);
  }

  .page-hero__title {
    margin: 0 0 1.25rem;
    font-size: clamp(1.8rem, 6vw, 2.75rem);
    line-height: 1.35;
    letter-spacing: 0.04em;
    color: var(--color-text);
  }

  .page-hero__lead {
    margin: 0 0 1.6rem;
    font-size: 1rem;
    line-height: 1.95;
    color: var(--color-text-muted);
    max-width: 44rem;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1rem;
  }

  .page-hero__visual {
    margin: 0;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    background: #f3f6fb;
  }

  .page-hero__visual img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0 1.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .btn--primary {
    background: #1e3a8a;
    color: #fff;
    border: 2px solid #1e3a8a;
  }

  .btn--primary:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    color: #fff;
  }

  .btn--secondary {
    background: #ffffff;
    color: var(--color-primary);
    border: 2px solid #1e3a8a;
  }

  .btn--secondary:hover {
    background: #eff4ff;
    color: var(--color-primary);
  }

  .concern-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  @media (min-width: 768px) {
    .concern-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .concern-item {
    position: relative;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1rem 1rem 1rem 2.75rem;
    line-height: 1.8;
    color: var(--color-text);
    box-shadow: var(--shadow-sm);
  }

  .concern-item::before {
    content: '✓';
    position: absolute;
    left: 1rem;
    top: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1rem;
    height: 1.1rem;
