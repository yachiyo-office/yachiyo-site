---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import LineButton from '../../../../components/LineButton.astro';
import BasicContentVisual from '../../../../components/BasicContentVisual.astro';
import { pageTitle } from '../../../../config/site';

const routeCards = [
  {
    title: '資格で要件を満たす',
    text: '許可を受けようとする業種に対応する国家資格等（施工管理技士、技能士、技術士等）を有していれば、専任技術者になれます。1人で複数業種を担当できる場合もありますが、1つの業種を2人以上で分担することはできません。',
  },
  {
    title: '実務経験で要件を満たす',
    text: '資格がなくても、許可を受けようとする業種について原則10年以上の実務経験があれば認められる場合があります。ただし、どの工事にどの期間従事したかを客観的資料で証明しなければなりません。',
  },
  {
    title: '許可業者での在籍経験',
    text: '建設業許可を受けている会社で専任技術者として在籍していた経験は、決算変更届や実務経験証明書等で証明できる場合があります。許可業者での経験は、資料整理のしやすさという面でメリットになることがあります。',
  },
];

const experiencePatterns = [
  {
    name: '一般建設業（実務経験ルート）',
    years: '10年以上',
    note: '許可を受けようとする業種に対応する工事経験が必要。同じ10年を複数業種に重ねて使うことはできません。',
  },
  {
    name: '特定建設業（実務経験ルート）',
    years: '10年＋2年',
    note: '一般建設業の要件に加え、請負代金4,500万円以上の工事における指導監督的実務経験2年以上が必要。',
  },
  {
    name: '指定建設業7業種（特定）',
    years: '資格必須',
    note: '土木・建築・電気・管・鋼構造物・舗装・造園の特定建設業は、実務経験だけでは足りず1級相当の資格等が必要です。',
  },
];

const whoCanBe = [
  {
    title: '役員である必要はない',
    text: '専任技術者は必ずしも取締役等の役員である必要はありません。営業所に常勤し、専らその職務に従事できる従業員でも要件を満たせます。重要なのは役職名ではなく、常勤性と技術要件そのものです。',
  },
  {
    title: '常勤性が前提',
    text: 'アルバイトや非常勤の勤務形態では、原則として専任技術者として認められにくいのが実情です。社会保険の加入状況や勤務時間、他社での専任兼務の有無も確認対象になります。',
  },
  {
    title: '出向社員の場合',
    text: '出向先の営業所に常勤している実態があり、出向協定書や在籍関係を資料で確認できる場合には、専任技術者として認められることがあります。通常の常勤性確認に加えて、追加資料が必要になることが多いです。',
  },
];

const proofDocs = [
  {
    title: '資格で申請する場合',
    items: [
      '資格証明書（写し）…… 有効な国家資格等の保有を確認',
      '実務経験証明書（様式第9号）…… 資格取得後の実務経験が必要な場合',
      '在籍確認資料 …… 被保険者記録照会回答票、雇用保険被保険者証等',
    ],
  },
  {
    title: '実務経験で申請する場合',
    items: [
      '実務経験証明書（様式第9号）…… 経験内容と期間を記載',
      '工事の請負契約書、注文書・請書、請求書＋入金記録 …… 工事実績を確認',
      '在籍確認資料 …… 経験期間中の在籍を確認',
    ],
  },
  {
    title: '許可業者での経験の場合',
    items: [
      '決算変更届の表紙（経験年数分）…… 許可業者での在籍を確認',
      '実務経験証明書 …… 専任技術者としての経験内容を確認',
      '許可通知書 …… 当該会社が許可業者であったことを確認',
    ],
  },
];

const placementRules = [
  '営業所ごとに、許可を受けようとする業種に対応した専任技術者が必要',
  '1人で複数業種を担当できる場合がある（資格・経験の内容による）',
  '1つの業種を2人以上で分担することはできない',
  '従たる営業所に専任技術者がいない業種は、その営業所では当該業種の工事を請け負えない',
  '許可取得後も退職・異動で不在になると、許可要件を満たさなくなる',
];

const faqItems = [
  {
    q: '施工管理技士がいれば、どの業種でも専任技術者になれますか？',
    a: '資格と業種の対応関係は法令で定められており、すべての業種に施工管理技士だけで対応できるわけではありません。保有資格がどの業種に対応するか、一般建設業と特定建設業のどちらに使えるかを個別に確認する必要があります。',
  },
  {
    q: '実務経験10年あれば、必ず要件を満たせますか？',
    a: '経験年数だけでは判断できません。許可を受けようとする業種に対応する工事経験であること、客観的資料で期間を証明できること、在籍確認が取れることが必要です。工事と工事の間が12か月以上空くと、連続した経験として認められない場合もあります。',
  },
  {
    q: '2業種の専任技術者を1人で兼ねられますか？',
    a: '資格や経験の内容次第で、1人が複数業種を担当できる場合があります。ただし、実務経験ルートで2業種を担当しようとする場合、原則として各業種10年ずつ、合計20年以上の経験が必要になります。',
  },
  {
    q: '現場配置技術者（監理・主任）と専任技術者は同じ人ですか？',
    a: '別の制度です。専任技術者は許可要件として営業所に置く技術者、現場配置技術者は工事現場に配置する技術者です。兼任できる場合もありますが、制限があるため、許可取得時だけでなく現場運用まで見据えた配置が必要です。',
  },
  {
    q: '専任技術者が退職した場合はどうなりますか？',
    a: '後任がいなければ許可要件を満たさなくなります。後任を置く場合も、変更届の提出期限（原則14日以内）があります。許可取得時と同様に、後任の資格または実務経験、常勤性を満たしている必要があります。',
  },
];

const relatedLinks = [
  {
    title: '建設業許可の基礎知識',
    text: '建設業許可の基本ルール、区分、5要件の全体像を整理した親ページです。',
    href: '/construction-permit/basic/',
  },
  {
    title: '経営業務の管理に関する体制（経管）',
    text: '専任技術者と並んで確認される主要要件です。経営経験と証明資料の考え方を確認したい方はこちら。',
    href: '/construction-permit/basic/requirements/management',
  },
  {
    title: '営業所の実体',
    text: '専任技術者は営業所ごとに配置します。営業所要件とあわせて確認したい方はこちら。',
    href: '/construction-permit/basic/requirements/office',
  },
];
---

<BaseLayout
  title={pageTitle('営業所技術者等（専任技術者）の要件と必要書類')}
  description="建設業許可の「営業所技術者等（専任技術者）」要件を解説。資格・実務経験10年、特定建設業の追加要件、常勤性、必要書類まで。大阪泉州・和歌山北部対応。"
  breadcrumbs={[
    { name: 'ホーム', href: '/' },
    { name: '建設業許可', href: '/construction-permit/' },
    { name: '基礎知識', href: '/construction-permit/basic/' },
    { name: '営業所技術者等' },
  ]}
>
  <div class="page">
    <SiteHeader />

    <main>
      <section class="page-hero section--base" aria-labelledby="page-heading">
        <div class="page-hero__inner">
          <nav class="breadcrumb" aria-label="パンくずリスト">
            <ol>
              <li><a href="/">ホーム</a></li>
              <li><a href="/construction-permit/">建設業許可</a></li>
              <li><a href="/construction-permit/basic/">基礎知識</a></li>
              <li aria-current="page">営業所技術者等</li>
            </ol>
          </nav>

          <div class="page-hero__content">
            <p class="page-hero__label">REQUIREMENTS</p>
            <h1 id="page-heading" class="page-hero__title">
              営業所技術者等（専任技術者）とは
            </h1>
            <p class="page-hero__lead">
              建設業許可には、営業所ごとに<strong>許可を受けようとする業種に対応した技術者</strong>を置くことが求められます。
              経営業務の管理に関する体制（経管）と並び、許可の可否や業種の範囲に直結する重要な要件です。
              資格を持っていれば要件を満たせる場合もあれば、資格がなくても一定の実務経験で認められる場合もあります。
              このページでは、2つのルートと証明資料の考え方を順に整理します。
            </p>
            <p class="page-hero__note">
              建設業法上の正式名称は「<strong>営業所技術者等</strong>」です。窓口や現場では「<strong>専任技術者</strong>」という呼び方も広く使われています。本ページでは、読みやすさのため両方の表記を併用して解説します。
            </p>

            <div class="page-hero__actions">
              <a href="/contact" class="btn btn--primary">相談してみる</a>
              <LineButton />
            </div>
          </div>

          <figure class="page-hero__visual">
            <img
              src="/images/requirement-engineer.jpg"
              alt="営業所技術者等の要件をイメージする建設現場の風景"
              loading="eager"
            />
          </figure>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="conclusion-heading">
        <div class="section__inner section__inner--narrow">
          <div class="summary-box">
            <h2 id="conclusion-heading" class="summary-box__heading">まず結論</h2>
            <p class="summary-box__text">
              専任技術者に求められるのは、<strong>許可を受けようとする業種に対応する資格、または原則10年以上の実務経験</strong>です。
              営業所ごとに配置し、常勤であることが前提です。
              実務上の最大のポイントは、資格・経験の有無だけでなく、<strong>客観的な資料で証明できるか</strong>にあります。
            </p>
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="why-heading">
        <div class="section__inner section__inner--narrow">
          <BasicContentVisual
            src="/images/basic-knowledge.jpg"
            alt="専任技術者の要件をイメージする書類確認"
          >
            <div class="section__head-block">
              <h2 id="why-heading" class="section__heading">
                <span class="heading-icon" aria-hidden="true"></span>
                なぜ重要な要件なのか
              </h2>
            </div>

            <p class="section__text">
              建設業許可制度は、適正な施工と発注者保護を目的としています。
              経営能力（経管）に加え、<strong>営業所として建設工事を適切に受注・管理する技術力</strong>があるかが問われます。
              見積りや請負契約に関する技術面の確認、施工に関する技術的対応など、
              営業所の技術的な中枢を担う存在が専任技術者です。
            </p>
            <p class="section__text">
              また、専任技術者は経管と同様に<strong>「人」に関する継続要件</strong>です。
              許可を取った後に退職や異動で不在になると、その時点で許可要件を満たさなくなります。
              許可取得時だけでなく、取得後の人員管理まで見据える必要があります。
            </p>
          </BasicContentVisual>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="routes-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="routes-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              要件を満たす主な3つのパターン
            </h2>
            <p class="section__sub">
              大きく分けると、資格ルート、実務経験ルート、許可業者での在籍経験ルートがあります。
            </p>
          </div>

          <div class="card-grid card-grid--three">
            {routeCards.map((item) => (
              <article class="info-card">
                <h3 class="info-card__title">{item.title}</h3>
                <p class="info-card__text">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="experience-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="experience-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              実務経験ルートの年数と内容
            </h2>
            <p class="section__sub">
              実務経験に含まれ得るのは、設計業務、現場監督・施工管理、施工に関する技術的業務などです。
              一般建設業と特定建設業では、求められる経験の質も異なります。
            </p>
          </div>

          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">区分</th>
                  <th scope="col" class="pattern-table__years-col">必要年数</th>
                </tr>
              </thead>
              <tbody>
                {experiencePatterns.map((row) => (
                  <tr>
                    <th scope="row">
                      {row.name}
                      <span class="pattern-table__note">{row.note}</span>
                    </th>
                    <td class="pattern-table__years-col">{row.years}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="section__note">
            ※実務経験の証明では、工事資料のほか在籍確認資料が必要になることが多く、資格ルートより立証の難易度が高めです。都道府県によって取扱いが異なる部分もあるため、申請先の手引きも確認してください。
          </p>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="who-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="who-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              誰が専任技術者になれるのか
            </h2>
            <p class="section__sub">
              役員である必要はありません。ただし、常勤性や専任性の確認は経管と同様に厳密です。
            </p>
          </div>

          <div class="card-grid card-grid--three">
            {whoCanBe.map((item) => (
              <article class="info-card">
                <h3 class="info-card__title">{item.title}</h3>
                <p class="info-card__text">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="placement-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="placement-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              配置のルール
            </h2>
            <p class="section__sub">
              専任技術者は「会社に1人いればよい」わけではなく、営業所と業種ごとに整理が必要です。
            </p>
          </div>

          <ul class="check-list">
            {placementRules.map((item) => (
              <li class="check-list__item">{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="proof-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="proof-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              必要となる主な書類
            </h2>
            <p class="section__sub">
              資格ルートと実務経験ルートでは、求められる資料が大きく異なります。
              実務経験ルートでは、経管と同様に過去の会社から書類を借りる必要が生じることも多いです。
            </p>
          </div>

          <div class="card-grid card-grid--three">
            {proofDocs.map((group) => (
              <article class="info-card">
                <h3 class="info-card__title">{group.title}</h3>
                <ul class="doc-list">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>

          <p class="section__note">
            ※電気工事業・消防施設工事業など、資格なしで行う業務が実務経験として認められにくい業種では、個別の確認が必要です。
          </p>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="faq-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="faq-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              よくあるご質問
            </h2>
          </div>

          <div class="faq-list">
            {faqItems.map((item) => (
              <details class="faq-item">
                <summary class="faq-item__question">{item.q}</summary>
                <div class="faq-item__answer">
                  <p>{item.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="lastly-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="lastly-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              人員配置次第で、取れる業種が変わります
            </h2>
          </div>

          <p class="section__text">
            専任技術者の要件は、経管と同様に「人」に依存する部分が大きい要件です。
            資格や経験があっても、資料で証明できなければ申請は進められません。
          </p>
          <p class="section__text">
            <strong>「経験や資格はあるが、資料がそろうか分からない」という段階でも、整理の余地があるケースは少なくありません。</strong>
            どの業種を目指すか、営業所をいくつ設けるか、許可業者での経験をどう活かすか——
            早めに人員と資料の両面から確認しておくことが、遠回りを防ぐ近道です。
          </p>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="related-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="related-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              関連ページ
            </h2>
          </div>

          <div class="card-grid card-grid--three">
            {relatedLinks.map((item) => (
              <article class="info-card info-card--link">
                <h3 class="info-card__title">{item.title}</h3>
                <p class="info-card__text">{item.text}</p>
                <a href={item.href} class="text-link">ページを見る</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--contact-cta">
        <div class="section__inner">
          <div class="cta-box">
            <h2 class="cta-box__heading">
              専任技術者の要件に当てはまるか、まずは一緒に整理しませんか。
            </h2>
            <p class="cta-box__text">
              「資格はあるが業種が合うか分からない」「実務経験の資料が足りるか不安」——そうした段階でもご相談いただけます。
              大阪泉州・和歌山北部を中心に、人員配置と資料の状況を確認しながら、見通しを分かりやすくご案内します。
            </p>

            <div class="cta-box__actions">
              <a href="/contact" class="btn btn--primary">お問い合わせフォームへ</a>
              <LineButton />
            </div>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #ffffff;
  }

  .section--base {
    background: #ffffff;
  }

  .section--band {
    background: #f8fafc;
    border-block: 1px solid var(--color-border);
  }

  .section {
    padding: var(--space-section-y) var(--space-section-x);
  }

  .section__inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .section__inner--narrow {
