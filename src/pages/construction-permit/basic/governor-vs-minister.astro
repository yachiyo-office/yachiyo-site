---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import LineButton from '../../../components/LineButton.astro';
import { pageTitle } from '../../../config/site';

const comparison = [
  {
    title: '知事許可（都道府県知事）',
    scope: '営業所が1つの都道府県内のみ',
    authority: '営業所の所在する都道府県の知事',
    note: '他府県の工事現場があっても、営業所が1県内なら知事許可が原則です。',
  },
  {
    title: '大臣許可（国土交通大臣）',
    scope: '2つ以上の都道府県に営業所がある',
    authority: '国土交通大臣',
    note: '営業所を複数県にまたがって設置する場合に必要になります。',
  },
];

const caseCards = [
  {
    title: '大阪に本社1つだけ',
    text: '和歌山や兵庫の現場工事があっても、営業所が大阪府内のみであれば大阪府知事許可です。工事現場の場所では判断しません。',
  },
  {
    title: '大阪に本社、和歌山に支店',
    text: '2つの都道府県に営業所があるため、大臣許可が必要です。大阪知事許可のまま和歌山に支店を追加することはできません。',
  },
  {
    title: '知事許可から大臣許可へ',
    text: '他府県に営業所を新設する場合、変更届ではなく「許可換え新規」申請が必要になります。許可行政庁が変わるためです。',
  },
];

const faqItems = [
  {
    q: '工事現場が他府県にあれば大臣許可になりますか？',
    a: 'なりません。知事許可か大臣許可かは、工事現場の場所ではなく営業所の所在で判断します。営業所が1つの都道府県内のみであれば、他府県の現場工事があっても知事許可が原則です。',
  },
  {
    q: '知事許可のまま他府県に支店を出せますか？',
    a: '支店を設置して2つ以上の都道府県に営業所がまたがる場合、大臣許可が必要になります。単なる変更届では済まず、許可換え新規申請が必要です。',
  },
  {
    q: '個人事業主でも知事許可と大臣許可の区別はありますか？',
    a: 'はい。法人・個人を問わず、営業所の所在によって知事許可か大臣許可かが決まります。',
  },
  {
    q: '大臣許可の方が「上」の許可ですか？',
    a: '許可の「格」が上と下があるわけではありません。営業所の配置に応じて、どちらの行政庁から許可を受けるかが決まるという整理です。ただし、申請手数料や必要書類の範囲が異なる場合があります。',
  },
  {
    q: '泉州・和歌山北部で知事許可を取る場合、どこの知事ですか？',
    a: '主たる営業所の所在する都道府県の知事が許可行政庁になります。大阪府内の営業所であれば大阪府知事、和歌山県内であれば和歌山県知事です。',
  },
];

const relatedLinks = [
  { title: '建設業許可の基礎知識', text: 'STEP 1〜3の全体像を整理した親ページです。', href: '/construction-permit/basic/' },
  { title: '一般建設業と特定建設業', text: '知事・大臣許可とは別軸の区分です。下請発注規模で一般か特定かが決まります。', href: '/construction-permit/basic/general-vs-specific' },
  { title: '申請区分', text: '許可換え新規など、申請目的に応じた区分の選び方を確認したい方はこちら。', href: '/construction-permit/basic/application-types' },
];
---

<BaseLayout
  title={pageTitle('知事許可と大臣許可の違い')}
  description="建設業許可の「知事許可」と「大臣許可」の違いを解説。判断基準は営業所の所在。工事現場の場所ではない点、許可換え新規が必要なケースまで。大阪泉州・和歌山北部対応。"
  breadcrumbs={[
    { name: 'ホーム', href: '/' },
    { name: '建設業許可', href: '/construction-permit/' },
    { name: '基礎知識', href: '/construction-permit/basic/' },
    { name: '知事許可と大臣許可' },
  ]}
>
  <div class="page">
    <SiteHeader />
    <main>
      <section class="page-hero section--base" aria-labelledby="page-heading">
        <div class="page-hero__inner">
          <nav class="breadcrumb" aria-label="パンくずリスト">
            <ol>
              <li><a href="/">ホーム</a></li>
              <li><a href="/construction-permit/">建設業許可</a></li>
              <li><a href="/construction-permit/basic/">基礎知識</a></li>
              <li aria-current="page">知事許可と大臣許可</li>
            </ol>
          </nav>
          <div class="page-hero__content">
            <p class="page-hero__label">BASIC KNOWLEDGE</p>
            <h1 id="page-heading" class="page-hero__title">知事許可と大臣許可の違い</h1>
            <p class="page-hero__lead">
              建設業許可には、<strong>都道府県知事許可</strong>と<strong>国土交通大臣許可</strong>があります。
              どちらを受けるかは、工事現場の場所ではなく<strong>営業所がどの都道府県にあるか</strong>で決まります。
              ここを誤解していると、必要な申請区分の整理もずれてしまうため、最初に押さえておきたいポイントです。
            </p>
            <div class="page-hero__actions">
              <a href="/contact" class="btn btn--primary">相談してみる</a>
              <LineButton />
            </div>
          </div>
          <figure class="page-hero__visual">
            <img src="/images/governor-minister-permit.jpg" alt="知事許可と大臣許可をイメージする建設業許可の風景" loading="eager" />
          </figure>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="conclusion-heading">
        <div class="section__inner section__inner--narrow">
          <div class="summary-box">
            <h2 id="conclusion-heading" class="summary-box__heading">まず結論</h2>
            <p class="summary-box__text">
              営業所が<strong>1つの都道府県内のみ</strong> → その都道府県知事の許可。
              営業所が<strong>2つ以上の都道府県</strong>にまたがる → 国土交通大臣の許可。
              他府県で工事をしても、営業所が1県内なら知事許可のままです。
            </p>
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="compare-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="compare-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              知事許可と大臣許可の比較
            </h2>
          </div>
          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">区分</th>
                  <th scope="col">該当するケース</th>
                  <th scope="col">許可行政庁</th>
                </tr>
              </thead>
              <tbody>
                {comparison.map((row) => (
                  <tr>
                    <th scope="row">
                      {row.title}
                      <span class="pattern-table__note">{row.note}</span>
                    </th>
                    <td>{row.scope}</td>
                    <td>{row.authority}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="cases-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="cases-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              具体例で見る判断のしかた
            </h2>
          </div>
          <div class="card-grid card-grid--three">
            {caseCards.map((item) => (
              <article class="info-card">
                <h3 class="info-card__title">{item.title}</h3>
                <p class="info-card__text">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="misconception-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="misconception-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              よくある誤解
            </h2>
          </div>
          <div class="attention-box">
            <h3 class="attention-box__title">「他府県の現場工事＝大臣許可」ではない</h3>
            <p class="attention-box__text">
              泉州エリアの会社が和歌山の現場で工事をする場合でも、営業所が大阪府内のみであれば大阪府知事許可です。
              逆に、営業所を和歌山にも設置すれば、たとえ大阪の現場ばかりでも大臣許可が必要になります。
            </p>
          </div>
          <p class="section__text section__text--spaced">
            また、知事許可から大臣許可へ（またはその逆）行政庁が変わる場合は、
            通常の変更届ではなく<strong>許可換え新規</strong>申請が必要です。
            営業所の追加・移転を計画している場合は、<a href="/construction-permit/basic/application-types">申請区分</a>もあわせて確認してください。
          </p>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="faq-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="faq-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              よくあるご質問
            </h2>
          </div>
          <div class="faq-list">
            {faqItems.map((item) => (
              <details class="faq-item">
                <summary class="faq-item__question">{item.q}</summary>
                <div class="faq-item__answer"><p>{item.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="related-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="related-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              関連ページ
            </h2>
          </div>
          <div class="card-grid card-grid--three">
            {relatedLinks.map((item) => (
              <article class="info-card info-card--link">
                <h3 class="info-card__title">{item.title}</h3>
                <p class="info-card__text">{item.text}</p>
                <a href={item.href} class="text-link">ページを見る</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--contact-cta">
        <div class="section__inner">
          <div class="cta-box">
            <h2 class="cta-box__heading">知事許可か大臣許可か、一緒に整理しませんか。</h2>
            <p class="cta-box__text">
              営業所の所在や今後の展開計画から、どちらの許可が必要か確認したい方はご相談ください。
              大阪泉州・和歌山北部を中心に、申請区分まで見据えてご案内します。
            </p>
            <div class="cta-box__actions">
              <a href="/contact" class="btn btn--primary">お問い合わせフォームへ</a>
              <LineButton />
            </div>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .page { min-height: 100vh; display: flex; flex-direction: column; background: #fff; }
  .section--base { background: #fff; }
  .section--band { background: #f8fafc; border-block: 1px solid var(--color-border); }
  .section { padding: var(--space-section-y) var(--space-section-x); }
  .section__inner { max-width: var(--content-max); margin: 0 auto; }
  .section__inner--narrow { max-width: 56rem; }
  .section__head-block { margin-bottom: 2rem; }
  .heading-icon { display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; border-radius: 0.4rem; background: #1e3a8a; flex-shrink: 0; vertical-align: middle; margin-right: 0.65rem; }
  .heading-icon::after { content: ''; width: 0.55rem; height: 0.72rem; border: 2px solid #fff; border-radius: 2px; }
  .section__heading { display: flex; align-items: center; flex-wrap: wrap; margin: 0 0 1rem; font-size: clamp(1.2rem, 2.8vw, 1.5rem); font-weight: 700; color: var(--color-primary); letter-spacing: 0.05em; line-height: 1.45; }
  .section__text { margin: 0 0 1rem; font-size: 0.95rem; line-height: 1.95; color: var(--color-text-muted); }
  .section__text:last-child { margin-bottom: 0; }
  .section__text--spaced { margin-top: 1.75rem; }
  .section__text strong { color: var(--color-text); }
  .section__text a { color: var(--color-primary); font-weight: 600; }
  .page-hero { padding: clamp(3.25rem, 9vw, 5.75rem) var(--space-section-x) max(var(--space-section-y), 3.75rem); }
  .page-hero__inner { max-width: var(--content-max); margin: 0 auto; display: grid; gap: 2rem 2.5rem; align-items: center; }
  @media (min-width: 960px) { .page-hero__inner { grid-template-columns: minmax(0, 1.12fr) minmax(280px, 0.88fr); } }
  .breadcrumb { grid-column: 1 / -1; }
  .breadcrumb ol { display: flex; flex-wrap: wrap; gap: 0.35rem 0.5rem; list-style: none; margin: 0 0 0.25rem; padding: 0; font-size: 0.8125rem; color: var(--color-text-muted); }
  .breadcrumb li:not(:last-child)::after { content: '/'; margin-left: 0.5rem; color: var(--color-border-strong); }
  .breadcrumb a { color: var(--color-text-muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--color-primary); }
  .breadcrumb li[aria-current='page'] { color: var(--color-text); font-weight: 600; }
  .page-hero__label { margin: 0 0 1rem; font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.16em; color: var(--color-primary); }
  .page-hero__title { margin: 0 0 1.25rem; font-size: clamp(1.9rem, 6vw, 2.8rem); line-height: 1.35; letter-spacing: 0.04em; color: var(--color-text); }
  .page-hero__lead { margin: 0 0 1.6rem; font-size: 1rem; line-height: 1.95; color: var(--color-text-muted); max-width: 46rem; }
  .page-hero__lead strong { color: var(--color-text); }
  .page-hero__actions { display: flex; flex-wrap: wrap; gap: 0.85rem 1rem; }
  .page-hero__visual { margin: 0; border-radius: 1rem; overflow: hidden; border: 1px solid var(--color-border); box-shadow: var(--shadow-md); background: #f3f6fb; }
  .page-hero__visual img { display: block; width: 100%; height: 100%; min-height: 280px; object-fit: cover; }
  .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0 1.5rem; font-size: 0.9375rem; font-weight: 700; letter-spacing: 0.04em; border-radius: var(--radius); text-decoration: none; transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease; }
  .btn--primary { background: #1e3a8a; color: #fff; border: 2px solid #1e3a8a; }
  .btn--primary:hover { background: var(--color-primary-hover); border-color: var(--color-primary-hover); color: #fff; }
  .summary-box { padding: 1.5rem; background: #fff; border: 1px solid var(--color-border); border-radius: 1rem; box-shadow: var(--shadow-sm); }
  .summary-box__heading { margin: 0 0 0.75rem; font-size: 1.15rem; font-weight: 700; color: var(--color-primary); }
  .summary-box__text { margin: 0; line-height: 1.9; color: var(--color-text-muted); }
  .summary-box__text strong { color: var(--color-text); }
  .card-grid { display: grid; gap: 1.25rem; }
  .card-grid--three { grid-template-columns: 1fr; }
  @media (min-width: 768px) { .card-grid--three { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .info-card { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.4rem; box-shadow: var(--shadow-sm); }
  .info-card--link { display: flex; flex-direction: column; }
  .info-card__title { margin: 0 0 0.75rem; font-size: 1rem; font-weight: 700; line-height: 1.6; color: var(--color-text); }
  .info-card__text { margin: 0; line-height: 1.9; color: var(--color-text-muted); font-size: 0.9375rem; }
  .text-link { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 1rem; width: fit-content; color: var(--color-primary); font-weight: 700; text-decoration: none; }
  .text-link::after { content: '→'; font-size: 0.95em; }
  .text-link:hover { text-decoration: underline; }
  .pattern-table-wrap { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow-x: auto; }
  .pattern-table { width: 100%; min-width: 34rem; border-collapse: collapse; font-size: 0.9375rem; }
  .pattern-table thead th { background: #1e3a8a; color: #fff; font-weight: 700; letter-spacing: 0.03em; text-align: left; padding: 0.85rem 1.25rem; }
  .pattern-table tbody th { text-align: left; font-weight: 700; color: var(--color-text); }
  .pattern-table th, .pattern-table td { padding: 0.95rem 1.25rem; border-bottom: 1px solid var(--color-border); line-height: 1.7; vertical-align: top; }
  .pattern-table tbody tr:last-child th, .pattern-table tbody tr:last-child td { border-bottom: none; }
  .pattern-table tbody tr:nth-child(even) { background: var(--color-band); }
  .pattern-table__note { display: block; margin-top: 0.35rem; font-size: 0.8125rem; font-weight: 400; color: var(--color-text-muted); }
  .attention-box { margin-top: 0; background: var(--color-primary-soft); border: 1px solid rgba(30, 58, 138, 0.2); border-radius: var(--radius-lg); padding: 1.5rem 1.65rem; }
  .attention-box__title { margin: 0 0 0.75rem; font-size: 0.9375rem; font-weight: 700; color: var(--color-primary); letter-spacing: 0.03em; }
  .attention-box__text { margin: 0; font-size: 0.9rem; line-height: 1.9; color: var(--color-text); }
  .faq-list { display: grid; gap: 1rem; }
  .faq-item { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow: hidden; }
  .faq-item__question { cursor: pointer; list-style: none; padding: 1.15rem 1.25rem; font-weight: 700; line-height: 1.7; color: var(--color-text); }
  .faq-item__question::-webkit-details-marker { display: none; }
  .faq-item__answer { padding: 0 1.25rem 1.15rem; color: var(--color-text-muted); line-height: 1.85; }
  .faq-item__answer p { margin: 0; }
  .section--contact-cta { background: #fff; padding: var(--space-section-y) var(--space-section-x) max(var(--space-section-y), 4rem); }
  .cta-box { background: #f8fafc; border: 1px solid var(--color-border); border-radius: 1rem; padding: clamp(1.75rem, 4vw, 2.5rem); box-shadow: var(--shadow-md); text-align: center; }
  .cta-box__heading { margin: 0 0 1rem; font-size: clamp(1.2rem, 2.8vw, 1.6rem); line-height: 1.6; color: var(--color-text); }
  .cta-box__text { margin: 0 0 1.5rem; color: var(--color-text-muted); line-height: 1.9; }
  .cta-box__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.85rem 1rem; }
</style>
