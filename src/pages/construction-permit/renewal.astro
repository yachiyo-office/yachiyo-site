---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LineButton from '../../components/LineButton.astro';
import BasicContentVisual from '../../components/BasicContentVisual.astro';
import { pageTitle } from '../../config/site';

const targetCases = [
  '許可の有効期限が近づいているが、何から手をつければよいか分からない',
  '決算変更届を数年分出していないまま、更新時期を迎えてしまった',
  '前回の更新は自分で行ったが、今回は任せたい',
  '役員や専任技術者が変わったのに、変更届を出せていない',
  '有効期限がいつなのか、そもそも把握できていない',
  '更新を機に、業種追加もあわせて検討したい',
];

const scheduleRows = [
  {
    timing: '有効期間満了日の3か月前',
    label: '受付開始',
    text: '多くの行政庁で、この時期から更新申請の受付が始まります。決算変更届の未提出がないかを確認し、準備を始めるタイミングです。',
  },
  {
    timing: '満了日の30日前',
    label: '申請期限',
    text: '建設業法上、更新申請は満了日の30日前までに行うこととされています。この期限を過ぎても受け付けてもらえる場合はありますが、余裕を持った申請が原則です。',
  },
  {
    timing: '満了日',
    label: '期限',
    text: '申請さえ済んでいれば、審査中に満了日を迎えても、処分があるまでは従前の許可が有効なものとして扱われます。',
  },
  {
    timing: '満了日の翌日',
    label: '失効',
    text: '申請しないまま満了日を過ぎると許可は失効します。復活の手続はなく、新規申請からやり直しになります。',
  },
];

const blockers = [
  {
    no: '01',
    title: '決算変更届の未提出',
    text: '更新申請で最も多いつまずきです。決算変更届（事業年度終了報告）が提出されていないと、更新申請そのものを受け付けてもらえません。5年分がまとめて必要になると、決算書の組み替えや工事経歴書の作成に相当の時間がかかります。',
  },
  {
    no: '02',
    title: '各種変更届の未提出',
    text: '役員の就任・退任、商号や所在地の変更、専任技術者の交代などは、その都度届出が必要です。届出内容と登記の内容が食い違ったままだと、更新時にまとめて是正を求められます。',
  },
  {
    no: '03',
    title: '経管・専任技術者の不在',
    text: '更新時にも、経営業務の管理責任者と専任技術者が在籍し、常勤していることが確認されます。退職や退任で不在になっている場合、後任を立てられなければ更新はできません。',
  },
];

const checkItems = [
  '許可の有効期限（許可通知書・許可票に記載）を確認する',
  '決算変更届を、直近まで毎年提出できているか確認する',
  '役員・商号・所在地・営業所に変更がなかったか確認する',
  '経営業務の管理責任者が現在も在籍・常勤しているか確認する',
  '業種ごとの専任技術者が現在も在籍・常勤しているか確認する',
  '社会保険の加入状況に変更がないか確認する',
  '欠格要件に該当する事由が生じていないか確認する',
];

const flowSteps = [
  {
    step: 'STEP 1',
    title: 'お問い合わせ・現状の確認',
    period: '当日〜数日',
    text: '許可通知書をお手元にご用意のうえ、ご連絡ください。有効期限、許可業種、決算変更届の提出状況をお伺いし、更新に向けて何が不足しているかを洗い出します。',
  },
  {
    step: 'STEP 2',
    title: '未提出の届出の確認・整理',
    period: '1〜4週間',
    text: '決算変更届や各種変更届に未提出のものがあれば、更新申請の前に提出します。ここが更新手続で最も時間を要する工程です。未提出の年数が多いほど、早めの着手が重要になります。',
  },
  {
    step: 'STEP 3',
    title: 'お見積り・ご契約',
    period: '数日',
    text: '更新申請の報酬に加え、未提出分の決算変更届や変更届が必要な場合はその費用も含め、総額を明示したお見積りをご提示します。',
  },
  {
    step: 'STEP 4',
    title: '要件の再確認・書類作成',
    period: '1〜2週間',
    text: '経管・専任技術者の在籍と常勤性、欠格要件、社会保険の加入状況を確認し、更新申請書一式を作成します。前回申請時から体制が変わっている場合は、変更点を正確に反映します。',
  },
  {
    step: 'STEP 5',
    title: '申請・審査',
    period: '知事許可 約30日 / 大臣許可 約90〜120日',
    text: '管轄の窓口へ申請します。審査中に満了日を迎えても、申請が受理されていれば従前の許可が有効なものとして扱われるため、営業を止める必要はありません。',
  },
  {
    step: 'STEP 6',
    title: '許可通知・次期スケジュールのご案内',
    period: '—',
    text: '新しい許可通知書が届いたら完了です。次の5年間に必要となる決算変更届の期限と、次回更新の時期をあわせてご案内します。',
  },
];

const costRows = [
  {
    name: '更新申請（知事許可）',
    detail: '5年ごとの更新',
    fee: '66,000円〜',
    legal: '50,000円',
  },
  {
    name: '更新申請（大臣許可）',
    detail: '5年ごとの更新',
    fee: '99,000円〜',
    legal: '50,000円',
  },
  {
    name: '決算変更届（未提出分）',
    detail: '複数年分をまとめて対応　1期につき',
    fee: '27,500円〜',
    legal: 'なし',
  },
  {
    name: '各種変更届',
    detail: '役員・所在地・商号の変更 等',
    fee: '16,500円〜',
    legal: 'なし',
  },
];

const faqItems = [
  {
    q: '更新はいつから準備すればよいですか？',
    a: '有効期間満了日の3〜6か月前からの準備をおすすめしています。決算変更届がすべて提出済みであれば3か月前でも間に合いますが、未提出分がある場合は、その作成に1〜2か月かかることも珍しくありません。期限が近い場合ほど、早めにご連絡ください。',
  },
  {
    q: '決算変更届を5年分出していません。更新できますか？',
    a: '未提出分をすべて提出すれば、更新申請は可能です。ただし各年度の工事経歴書と財務諸表を作成する必要があるため、相応の期間と費用がかかります。期限まで日がない場合は、まず優先順位を整理してご案内しますので、諦める前にご相談ください。',
  },
  {
    q: '有効期限を過ぎてしまいました。どうなりますか？',
    a: '許可は失効します。更新という形での復活はできず、あらためて新規申請を行うことになります。手数料も更新の5万円ではなく新規の9万円（知事許可）となり、要件も新規と同じ基準で審査されます。失効期間中は500万円以上の工事を請け負えない点にもご注意ください。',
  },
  {
    q: '更新のときも、財産的基礎の500万円は必要ですか？',
    a: '一般建設業の更新では、許可を継続して有していること自体で財産的基礎の要件を満たすものとして扱われるのが原則です。一方、特定建設業は更新のたびに資本金・自己資本・欠損比率・流動比率の財務要件を満たしている必要があります。特定建設業をお持ちの場合は、直前決算の内容確認が重要になります。',
  },
  {
    q: '更新と業種追加を同時に申請できますか？',
    a: 'できます。更新申請と業種追加を同時に行うことで、手数料や書類の重複を抑えられる場合があります。ただし業種追加には専任技術者の要件確認が必要なため、更新の準備と並行して早めに検討を始めることをおすすめします。',
  },
  {
    q: '審査中に有効期限が来てしまいますが、工事を続けられますか？',
    a: '期限内に更新申請が受理されていれば、審査結果が出るまでの間は従前の許可が有効なものとして扱われます。そのため、営業や工事の受注を止める必要はありません。ただし、これは申請が期限内に済んでいる場合に限られます。',
  },
];

const relatedLinks = [
  {
    title: '建設業許可 新規申請',
    text: 'これから初めて許可を取得する方向けに、要件確認から申請までの流れをご案内しています。',
    href: '/construction-permit/new',
  },
  {
    title: '建設業許可の基礎知識',
    text: '許可の区分や5つの要件など、制度の全体像を体系的に整理しています。',
    href: '/construction-permit/basic/',
  },
  {
    title: '決算変更届',
    text: '更新申請の前提となる毎年の届出です。未提出があると更新を進められません。',
    href: '/construction-permit/annual-report',
  },
];
---

<BaseLayout
  title={pageTitle('建設業許可の更新申請サポート')}
  description="大阪泉州・和歌山北部の建設業許可 更新申請をサポート。決算変更届の未提出、変更届の漏れ、更新期限のスケジュール、費用の目安まで、更新でつまずかないための要点をご案内します。"
  breadcrumbs={[
    { name: 'ホーム', href: '/' },
    { name: '建設業許可', href: '/construction-permit/' },
    { name: '更新申請' },
  ]}
>
  <div class="page">
    <SiteHeader />

    <main>
      <section class="page-hero section--base" aria-labelledby="page-heading">
        <div class="page-hero__inner">
          <nav class="breadcrumb" aria-label="パンくずリスト">
            <ol>
              <li><a href="/">ホーム</a></li>
              <li><a href="/construction-permit/">建設業許可</a></li>
              <li aria-current="page">更新申請</li>
            </ol>
          </nav>

          <div class="page-hero__content">
            <p class="page-hero__label">SERVICE</p>
            <h1 id="page-heading" class="page-hero__title">
              建設業許可の更新申請サポート
            </h1>
            <p class="page-hero__lead">
              建設業許可の有効期間は5年間です。更新そのものは難しい手続ではありません。
              それでも更新でつまずく事業者さまが多いのは、
              <strong>更新の可否が、それまでの5年間の届出の積み重ねで決まる</strong>からです。
              決算変更届が未提出のままだと、更新申請は受け付けてもらえません。
            </p>
            <p class="page-hero__note">
              「決算変更届を何年も出していない」「期限まで日がない」という状況でもご相談いただけます。
              まず何から着手すべきかを整理してご案内します。
            </p>

            <div class="page-hero__actions">
              <a href="/contact" class="btn btn--primary">相談してみる</a>
              <LineButton />
            </div>
          </div>

          <figure class="page-hero__visual">
            <img
              src="/images/construction-documents.jpg"
              alt="建設業許可の更新手続に必要な書類のイメージ"
              loading="eager"
            />
          </figure>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="conclusion-heading">
        <div class="section__inner section__inner--narrow">
          <div class="summary-box">
            <h2 id="conclusion-heading" class="summary-box__heading">まず結論</h2>
            <p class="summary-box__text">
              更新でやるべきことは、実質的に2つです。
              <strong>①これまでの決算変更届・各種変更届がすべて提出済みか確認すること</strong>、
              <strong>②経管と専任技術者が現在も在籍・常勤しているか確認すること</strong>。
              この2点がクリアできていれば、更新申請自体はスムーズに進みます。
              期限を過ぎて失効すると新規申請からやり直しになるため、
              満了日の<strong>3〜6か月前</strong>からの準備をおすすめします。
            </p>
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="target-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="target-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              こんな方にご利用いただいています
            </h2>
          </div>

          <ul class="check-list">
            {targetCases.map((item) => (
              <li class="check-list__item">{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="schedule-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="schedule-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              更新のスケジュールと期限
            </h2>
            <p class="section__sub">
              建設業許可の有効期間は、許可のあった日から5年目の対応する日の前日までです。
              満了日から逆算して、次のスケジュールで進みます。
            </p>
          </div>

          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">時期</th>
                  <th scope="col">内容</th>
                </tr>
              </thead>
              <tbody>
                {scheduleRows.map((row) => (
                  <tr>
                    <th scope="row">
                      {row.timing}
                      <span class="pattern-table__tag">{row.label}</span>
                    </th>
                    <td>{row.text}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="section__note">
            ※受付開始の時期は行政庁によって異なる場合があります。申請先の取扱いを確認したうえでご案内します。
          </p>

          <div class="attention-box attention-box--warn">
            <h3 class="attention-box__title">失効すると「新規申請」からやり直しになります</h3>
            <p class="attention-box__text">
              更新には、うっかり忘れを救済する制度がありません。満了日を過ぎれば許可は失効し、
              あらためて新規申請を行うことになります。手数料は5万円から9万円（知事許可）に上がり、
              経営経験や専任技術者の要件も新規と同じ基準で審査されます。
              さらに、失効から新しい許可が下りるまでの間は、500万円以上の工事を請け負えません。
              元請との契約に影響が及ぶこともあるため、期限管理はとりわけ重要です。
            </p>
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="blocker-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="blocker-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              更新を止めてしまう3つの原因
            </h2>
            <p class="section__sub">
              更新申請そのものより、その手前で引っかかるケースがほとんどです。
              いずれも、これまでの5年間に本来行っておくべきだった手続の積み残しから生じます。
            </p>
          </div>

          <div class="card-grid card-grid--three">
            {blockers.map((item) => (
              <article class="point-card">
                <span class="point-card__no">{item.no}</span>
                <h3 class="point-card__title">{item.title}</h3>
                <p class="point-card__text">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="kessan-heading">
        <div class="section__inner section__inner--narrow">
          <BasicContentVisual
            src="/images/requirement-financial.jpg"
            alt="決算変更届の作成に必要な決算書類のイメージ"
          >
            <div class="section__head-block">
              <h2 id="kessan-heading" class="section__heading">
                <span class="heading-icon" aria-hidden="true"></span>
                更新の鍵を握るのは「決算変更届」です
              </h2>
            </div>

            <p class="section__text">
              決算変更届（事業年度終了報告）は、事業年度終了後4か月以内に毎年提出する届出です。
              提出しないままでも日々の営業に支障はないため、後回しにされがちですが、
              <strong>未提出のままでは更新申請を受け付けてもらえません</strong>。
            </p>
            <p class="section__text">
              決算変更届では、税務申告用の決算書をそのまま使うことはできず、
              建設業法で定められた様式に組み替えた財務諸表を作成する必要があります。
              あわせて、その年度に施工した工事の工事経歴書も作成します。
              5年分をまとめて作るとなると、決算書と工事資料をさかのぼって突き合わせる作業が発生し、
              1〜2か月かかることも珍しくありません。
            </p>
            <p class="section__text">
              未提出の状態が続いていると、行政指導や監督処分の対象となる可能性もあります。
              更新のタイミングを待たず、気づいた時点で整理しておくことが望ましい手続です。
            </p>
            <a href="/construction-permit/annual-report" class="text-link">決算変更届について詳しく見る</a>
          </BasicContentVisual>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="check-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="check-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              更新前セルフチェック
            </h2>
            <p class="section__sub">
              ご相談前に、次の項目をご確認いただけるとスムーズです。
              分からない項目があっても問題ありません。こちらで一緒に確認します。
            </p>
          </div>

          <ul class="check-list">
            {checkItems.map((item) => (
              <li class="check-list__item">{item}</li>
            ))}
          </ul>

          <p class="section__note">
            ※許可の有効期限は、許可通知書または現場に掲示している建設業の許可票に記載されています。
            見当たらない場合でも、行政庁の許可業者名簿から確認できますのでご相談ください。
          </p>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="flow-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="flow-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              更新申請の流れ
            </h2>
            <p class="section__sub">
              決算変更届がすべて提出済みであれば、ご相談から申請まで2〜4週間程度です。
              未提出分がある場合は、その整理に要する期間が加わります。
            </p>
          </div>

          <ol class="flow-list">
            {flowSteps.map((item) => (
              <li class="flow-step">
                <div class="flow-step__head">
                  <span class="flow-step__label">{item.step}</span>
                  <span class="flow-step__period">{item.period}</span>
                </div>
                <p class="flow-step__title">{item.title}</p>
                <p class="flow-step__text">{item.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="cost-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="cost-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              費用の目安
            </h2>
            <p class="section__sub">
              報酬額は税込表示です。法定費用（申請手数料）は別途、実費としてご負担いただきます。
              未提出の決算変更届がある場合は、更新申請の報酬に加えて年度ごとの費用が発生します。
            </p>
          </div>

          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">手続</th>
                  <th scope="col" class="pattern-table__num-col">報酬（税込）</th>
                  <th scope="col" class="pattern-table__num-col">法定費用</th>
                </tr>
              </thead>
              <tbody>
                {costRows.map((row) => (
                  <tr>
                    <th scope="row">
                      {row.name}
                      <span class="pattern-table__note">{row.detail}</span>
                    </th>
                    <td class="pattern-table__num-col">{row.fee}</td>
                    <td class="pattern-table__num-col">{row.legal}</td>
                  </tr>
