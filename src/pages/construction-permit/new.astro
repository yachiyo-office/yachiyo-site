---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LineButton from '../../components/LineButton.astro';
import BasicContentVisual from '../../components/BasicContentVisual.astro';
import { pageTitle } from '../../config/site';

const targetCases = [
  '元請や取引先から「許可を取らないと発注できない」と言われている',
  '500万円以上の工事を請けられる体制にしたい',
  '個人事業から法人成りを機に、あわせて許可を取得したい',
  '自社が要件を満たしているのか、まず確認したい',
  '過去に自分で申請しようとして、書類の準備で止まってしまった',
  '公共工事への参入を見据えて、まず許可取得から始めたい',
];

const stumblingPoints = [
  {
    no: '01',
    title: '経営経験を「資料で」証明できない',
    text: '経営業務の管理責任者（経管）には原則5年以上の建設業の経営経験が必要です。経験そのものはあっても、当時の確定申告書や工事の請負契約書・注文書がそろわず、年数がつながらないケースが最も多いつまずきどころです。',
    href: '/construction-permit/basic/requirements/management',
    linkLabel: '経営業務の管理責任者を詳しく見る',
  },
  {
    no: '02',
    title: '専任技術者の資格・実務経験が足りない',
    text: '取得したい業種ごとに、営業所に配置する専任技術者（営業所技術者等）が必要です。資格で証明するか実務経験10年で証明するかによって、集める資料の量が大きく変わります。業種の選び方から検討が必要になることもあります。',
    href: '/construction-permit/basic/requirements/engineer',
    linkLabel: '専任技術者の要件を詳しく見る',
  },
  {
    no: '03',
    title: '財産的基礎（500万円）の証明タイミング',
    text: '一般建設業では、直前決算の自己資本500万円以上、または500万円以上の資金調達能力が求められます。残高証明書で証明する場合は有効期間が限られるため、他の書類の準備状況を見ながら取得のタイミングを合わせる必要があります。',
    href: '/construction-permit/basic/requirements/financial',
    linkLabel: '財産的基礎の考え方を見る',
  },
];

const permitTypes = [
  {
    axis: '知事許可 / 大臣許可',
    judge: '営業所の所在地',
    detail:
      '1つの都道府県内にのみ営業所があれば知事許可、2つ以上の都道府県に営業所があれば大臣許可です。工事をする場所ではなく、営業所の場所で決まります。',
    href: '/construction-permit/basic/governor-vs-minister',
  },
  {
    axis: '一般建設業 / 特定建設業',
    judge: '元請として下請に出す金額',
    detail:
      '元請として下請に出す金額の合計が4,500万円（建築一式は7,000万円）以上になる場合は特定建設業が必要です。それ以外は一般建設業で対応できます。',
    href: '/construction-permit/basic/general-vs-specific',
  },
  {
    axis: '業種（29業種）',
    judge: '実際に請け負う工事の内容',
    detail:
      '建設業許可は29業種に分かれており、業種ごとに取得します。専任技術者の要件も業種単位で判断されるため、どの業種で申請するかが出発点になります。',
    href: '/construction-permit/basic/29-industries',
  },
];

const requirements = [
  {
    name: '経営業務の管理に関する体制（経管）',
    point: '原則5年以上の建設業の経営経験を、資料で証明できること',
    href: '/construction-permit/basic/requirements/management',
  },
  {
    name: '営業所技術者等（専任技術者）',
    point: '業種ごとに、資格または実務経験を満たす技術者を営業所に常勤で配置すること',
    href: '/construction-permit/basic/requirements/engineer',
  },
  {
    name: '財産的基礎・金銭的信用',
    point: '一般建設業は自己資本500万円以上、または500万円以上の資金調達能力',
    href: '/construction-permit/basic/requirements/financial',
  },
  {
    name: '営業所の要件',
    point: '契約締結などの実体があり、独立した事務スペースが確保されていること',
    href: '/construction-permit/basic/requirements/office',
  },
  {
    name: '誠実性・欠格要件に該当しないこと',
    point: '役員等に一定の前歴等がないこと、請負契約に関して不正・不誠実な行為がないこと',
    href: '/construction-permit/basic/requirements/disqualification',
  },
];

const ourRole = [
  '許可が必要かどうか、どの区分・業種で申請するかの整理',
  '要件を満たしているかの事前確認と、不足がある場合の対応方針のご提案',
  '必要書類の一覧化と、収集順序のご案内',
  '登記事項証明書・納税証明書など、公的な証明書類の代理取得（可能なもの）',
  '申請書一式の作成と、確認資料の編綴',
  '行政庁への事前相談・申請書の提出',
  '補正が生じた場合の対応',
  '許可取得後に必要となる決算変更届・更新のスケジュールのご案内',
];

const clientRole = [
  '過去の工事に関する請負契約書・注文書・請求書などの原本のご提供',
  '確定申告書・決算書の控えのご提供',
  '資格証・卒業証明書など、専任技術者の証明資料のご準備',
  '社会保険の加入状況が分かる資料のご提供',
  '申請書への押印（法人実印・個人実印）',
];

const flowSteps = [
  {
    step: 'STEP 1',
    title: 'お問い合わせ・無料相談',
    period: '当日〜数日',
    text: 'お電話・公式LINE・お問い合わせフォームからご連絡ください。現在の事業内容、請け負いたい工事、社内の体制などをお伺いし、許可取得の見通しを大まかにご説明します。「許可が必要かどうか分からない」という段階で構いません。',
  },
  {
    step: 'STEP 2',
    title: '要件の確認・申請方針の決定',
    period: '1〜2週間',
    text: '経管・専任技術者を誰にするか、どの業種で申請するか、一般か特定か、知事許可か大臣許可かを整理します。証明資料がそろうかどうかもこの段階で確認し、不足があれば代替案を検討します。ここが新規申請で最も重要な工程です。',
  },
  {
    step: 'STEP 3',
    title: 'お見積り・ご契約',
    period: '数日',
    text: '確定した申請内容にもとづき、報酬額と法定費用を明示したお見積りをご提示します。ご納得いただいたうえでご契約となりますので、途中で費用が膨らむご心配はありません。',
  },
  {
    step: 'STEP 4',
    title: '書類の収集・作成',
    period: '2〜4週間',
    text: '当事務所で取得できる証明書は代理取得し、お客様には工事資料や決算書などをご準備いただきます。並行して申請書一式を作成し、確認資料を整えます。資料の状況によって、この工程の期間は大きく変わります。',
  },
  {
    step: 'STEP 5',
    title: '申請・審査',
    period: '知事許可 約30日 / 大臣許可 約90〜120日',
    text: '管轄の窓口へ申請書を提出します。審査中に補正の指示があった場合は、当事務所で対応します。標準処理期間は行政庁が公表しているもので、申請の混雑状況によって前後します。',
  },
  {
    step: 'STEP 6',
    title: '許可通知・取得後のご案内',
    period: '—',
    text: '許可通知書が届いたら手続完了です。あわせて、毎年の決算変更届の期限、5年後の更新時期、変更が生じたときに必要な届出について、今後のスケジュールをご案内します。',
  },
];

const costRows = [
  {
    name: '新規申請（知事許可・個人）',
    detail: '般・特 1業種',
    fee: '99,000円〜',
    legal: '90,000円',
  },
  {
    name: '新規申請（知事許可・法人）',
    detail: '般・特 1業種',
    fee: '121,000円〜',
    legal: '90,000円',
  },
  {
    name: '新規申請（大臣許可）',
    detail: '般・特 1業種',
    fee: '176,000円〜',
    legal: '150,000円',
  },
];

const faqItems = [
  {
    q: '許可を取得するまで、どのくらいの期間がかかりますか？',
    a: '知事許可の場合、ご相談から許可取得まで、おおむね2〜3か月程度を見込んでいただくことが多いです。審査自体は約30日ですが、それ以前の要件確認と資料収集に時間がかかります。特に過去の工事資料を集める必要がある場合は、さらに期間を要することもあります。',
  },
  {
    q: '個人事業主でも建設業許可を取れますか？',
    a: '取得できます。個人事業主ご本人が経営業務の管理責任者となり、要件を満たせば申請可能です。ただし、後に法人成りを予定されている場合、個人で取得した許可は法人へ引き継げないケースがあるため（事業承継の認可を受ける場合を除く）、法人化のタイミングも含めてご相談いただくことをおすすめします。',
  },
  {
    q: '会社を設立したばかりでも申請できますか？',
    a: '設立直後でも申請は可能です。経営業務の管理責任者となる方が、以前の会社や個人事業での建設業の経営経験を5年以上お持ちであれば、その経験で要件を満たせます。財産的基礎については、設立時の資本金が500万円以上であれば創業時の財務諸表で証明できます。',
  },
  {
    q: '複数の業種をまとめて申請できますか？',
    a: 'できます。ただし業種ごとに専任技術者の要件を満たす必要があるため、実際に取得できる業種はお持ちの資格や実務経験によって決まります。まずは今後の受注予定を踏まえて、必要な業種を整理するところからご一緒します。',
  },
  {
    q: '社会保険に加入していないと許可は取れませんか？',
    a: '原則として取得できません。令和2年10月の建設業法改正により、適切な社会保険への加入が許可要件となりました。加入義務のある事業者が未加入の場合、許可を受けられません。現在の加入状況によっては、まず社会保険の手続から整理することになります。',
  },
  {
    q: '要件を満たしていないと分かった場合、費用はかかりますか？',
    a: 'ご契約前の相談段階で要件を満たさないことが判明した場合、費用は発生しません。「今は満たせないが、いつ・何を整えれば取得できるか」という見通しをお伝えしたうえで、次の一歩をご案内します。',
  },
];

const relatedLinks = [
  {
    title: '建設業許可の基礎知識',
    text: '許可の必要性、区分、5つの要件まで、制度の全体像を体系的に整理しています。',
    href: '/construction-permit/basic/',
  },
  {
    title: '建設業許可 更新申請',
    text: '5年ごとの更新手続。決算変更届の未提出など、更新時の注意点をまとめています。',
    href: '/construction-permit/renewal',
  },
  {
    title: '決算変更届',
    text: '許可取得後、毎年必要になる届出です。5年後の更新を左右する重要な手続です。',
    href: '/construction-permit/annual-report',
  },
];
---

<BaseLayout
  title={pageTitle('建設業許可の新規申請サポート')}
  description="大阪泉州・和歌山北部の建設業許可 新規申請をサポート。要件確認から書類収集、申請までの流れ、必要期間と費用の目安、つまずきやすいポイントまで分かりやすくご案内します。"
  breadcrumbs={[
    { name: 'ホーム', href: '/' },
    { name: '建設業許可', href: '/construction-permit/' },
    { name: '新規申請' },
  ]}
>
  <div class="page">
    <SiteHeader />

    <main>
      <section class="page-hero section--base" aria-labelledby="page-heading">
        <div class="page-hero__inner">
          <nav class="breadcrumb" aria-label="パンくずリスト">
            <ol>
              <li><a href="/">ホーム</a></li>
              <li><a href="/construction-permit/">建設業許可</a></li>
              <li aria-current="page">新規申請</li>
            </ol>
          </nav>

          <div class="page-hero__content">
            <p class="page-hero__label">SERVICE</p>
            <h1 id="page-heading" class="page-hero__title">
              建設業許可の新規申請サポート
            </h1>
            <p class="page-hero__lead">
              建設業許可の新規申請でつまずくのは、書類の書き方ではありません。
              ほとんどの場合、<strong>要件を満たしていることを資料で証明できるか</strong>という一点に集約されます。
              やちよ行政書士事務所では、大阪泉州・和歌山北部の事業者さまを中心に、
              要件の確認から資料の収集、申請、そして許可取得後の管理まで見据えてサポートします。
            </p>
            <p class="page-hero__note">
              「そもそも自社に許可が必要なのか」「要件を満たしているのか」という段階からご相談いただけます。
              ご契約前の相談で要件を満たさないと判明した場合、費用はいただきません。
            </p>

            <div class="page-hero__actions">
              <a href="/contact" class="btn btn--primary">相談してみる</a>
              <LineButton />
            </div>
          </div>

          <figure class="page-hero__visual">
            <img
              src="/images/construction-permit-main.jpg"
              alt="建設業許可の新規申請に向けた打ち合わせ風景"
              loading="eager"
            />
          </figure>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="conclusion-heading">
        <div class="section__inner section__inner--narrow">
          <div class="summary-box">
            <h2 id="conclusion-heading" class="summary-box__heading">まず結論</h2>
            <p class="summary-box__text">
              新規申請の成否を分けるのは、申請書の作成そのものではなく、
              <strong>その手前にある「要件確認」と「証明資料の収集」</strong>です。
              ここを最初に固めてしまえば、あとの工程は着実に進みます。
              逆に、資料が足りないまま走り出すと、途中で止まって時間だけが過ぎてしまいます。
              だからこそ、<strong>着手前の見通しづくり</strong>に最も時間をかけています。
            </p>
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="target-heading">
        <div class="section__inner section__inner--narrow">
          <div class="section__head-block">
            <h2 id="target-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              こんな方にご利用いただいています
            </h2>
          </div>

          <ul class="check-list">
            {targetCases.map((item) => (
              <li class="check-list__item">{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="stumbling-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="stumbling-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              新規申請でつまずきやすい3つのポイント
            </h2>
            <p class="section__sub">
              ご相談をお受けするなかで、実際に手が止まりやすいのは次の3点です。
              いずれも「早めに確認しておけば対処できた」というケースが少なくありません。
            </p>
          </div>

          <div class="card-grid card-grid--three">
            {stumblingPoints.map((item) => (
              <article class="point-card">
                <span class="point-card__no">{item.no}</span>
                <h3 class="point-card__title">{item.title}</h3>
                <p class="point-card__text">{item.text}</p>
                <a href={item.href} class="text-link">{item.linkLabel}</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="types-heading">
        <div class="section__inner section__inner--narrow">
          <BasicContentVisual
            src="/images/application-types.jpg"
            alt="建設業許可の申請区分を整理するイメージ"
          >
            <div class="section__head-block">
              <h2 id="types-heading" class="section__heading">
                <span class="heading-icon" aria-hidden="true"></span>
                最初に決めるのは「どの区分で申請するか」
              </h2>
            </div>

            <p class="section__text">
              建設業許可は一種類ではありません。営業所の所在地、元請として下請に出す金額、
              実際に請け負う工事の内容という3つの軸で、申請する区分が決まります。
              ここを取り違えると、そろえる資料も、必要な要件も変わってしまいます。
            </p>
            <p class="section__text">
              「とりあえず取れる業種で取っておく」という進め方は、
              後から必要な業種を追加することになり、かえって手間と費用がかかることがあります。
              今後3〜5年の受注見込みを踏まえて決めることをおすすめしています。
            </p>
          </BasicContentVisual>

          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">区分の軸</th>
                  <th scope="col">何で決まるか</th>
                </tr>
              </thead>
              <tbody>
                {permitTypes.map((row) => (
                  <tr>
                    <th scope="row">
                      {row.axis}
                      <span class="pattern-table__note">{row.detail}</span>
                    </th>
                    <td>
                      {row.judge}
                      <a href={row.href} class="pattern-table__link">詳しく見る</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="requirements-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="requirements-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              確認すべき5つの許可要件
            </h2>
            <p class="section__sub">
              新規申請では、次の要件をすべて満たしていることを資料で示す必要があります。
              加えて、令和2年10月の建設業法改正以降は<strong>適切な社会保険への加入</strong>も要件となっています。
            </p>
          </div>

          <div class="pattern-table-wrap">
            <table class="pattern-table">
              <thead>
                <tr>
                  <th scope="col">要件</th>
                  <th scope="col">確認のポイント</th>
                </tr>
              </thead>
              <tbody>
                {requirements.map((row) => (
                  <tr>
                    <th scope="row">
                      {row.name}
                      <a href={row.href} class="pattern-table__link">詳しく見る</a>
                    </th>
                    <td>{row.point}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="attention-box">
            <h3 class="attention-box__title">要件を満たしていない場合でも、道が閉ざされるわけではありません</h3>
            <p class="attention-box__text">
              経営経験が5年に届かない、専任技術者の実務経験の証明資料が足りない、直前決算の自己資本が500万円に満たない——
              こうした場合でも、「いつ・何を整えれば申請できるか」という時期の見通しを立てることはできます。
              残高証明書で財産的基礎を証明する、経験のある方を常勤役員として迎える、次の決算を待つなど、
              状況に応じて取りうる選択肢をご提案します。
            </p>
          </div>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="scope-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="scope-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              サポートの範囲
            </h2>
            <p class="section__sub">
              どこまでを当事務所が担い、どこをお客様にお願いするかを、着手前に明確にしています。
            </p>
          </div>

