---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { pageTitle } from '../config/site';
---

<BaseLayout
  title={pageTitle('お問い合わせ')}
  description="建設業許可や決算変更届など、お手続のご相談はこちら。大阪泉州・和歌山北部の事業者さま向け。必要かどうか分からない段階でもお気軽にお問い合わせください。"
  breadcrumbs={[{ name: 'ホーム', href: '/' }, { name: 'お問い合わせ' }]}
>
  <div class="page">
    <SiteHeader />

    <main>
      <div class="contact-container">
        <nav class="breadcrumb" aria-label="パンくずリスト">
          <ol>
            <li><a href="/">ホーム</a></li>
            <li aria-current="page">お問い合わせ</li>
          </ol>
        </nav>

        <h1>お問い合わせ</h1>
        <p class="lead-text">
          ご相談・ご依頼は、以下のフォームよりお気軽にお問い合わせください。<br />
          内容を確認後、担当者より原則2営業日以内にご連絡させていただきます。
        </p>

        <div class="privacy-note">
          <p class="privacy-note__title">個人情報の取り扱いについて</p>
          <p class="privacy-note__text">
            ご入力いただいた個人情報は、お問い合わせへの回答およびご相談内容の確認のためにのみ利用し、<a
              href="/privacy/">プライバシーポリシー</a
            >に基づき適切に管理いたします。ご本人の同意なく第三者に提供することはありません。フォームの送信をもって、プライバシーポリシーにご同意いただいたものとみなします。
          </p>
        </div>

        <div class="form-wrapper">
          <iframe
            src="https://docs.google.com/forms/d/e/1FAIpQLSdV-DqznaOu27lWhWlYLtUokIqHIJ_BNNsEnFrFdyQx20f95g/viewform?embedded=true"
            width="100%"
            height="850"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            title="お問い合わせフォーム"
            style="border: none; background: transparent;"
          >
            読み込んでいます…
          </iframe>
        </div>
      </div>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #ffffff;
  }

  .contact-container {
    max-width: 800px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 3.5rem) var(--space-section-x);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
  .breadcrumb li:not(:last-child)::after {
    content: '/';
    margin-left: 0.5rem;
    color: var(--color-border-strong);
  }
  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--color-primary);
  }
  .breadcrumb li[aria-current='page'] {
    color: var(--color-text);
    font-weight: 600;
  }

  h1 {
    text-align: center;
    color: var(--color-primary);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 0 0 1.25rem;
    position: relative;
    padding-bottom: 0.75rem;
  }

  h1::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background-color: var(--color-primary);
    border-radius: 2px;
  }

  .lead-text {
    text-align: center;
    color: var(--color-text-muted);
    line-height: 1.85;
    margin: 0 0 2.5rem;
    font-size: 0.9375rem;
  }

  .privacy-note {
    background: var(--color-primary-soft);
    border: 1px solid rgba(30, 58, 138, 0.2);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    margin: 0 0 2rem;
  }

  .privacy-note__title {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.03em;
  }

  .privacy-note__text {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.9;
    color: var(--color-text);
  }

  .privacy-note__text a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .form-wrapper {
    background: #ffffff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
    padding: 10px;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .contact-container {
      padding: 2rem 1rem;
    }

    .lead-text {
      text-align: left;
    }

    .form-wrapper {
      padding: 0;
    }
  }
</style>
