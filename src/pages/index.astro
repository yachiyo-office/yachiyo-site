---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
import LineButton from '../components/LineButton.astro';
import { pageTitle } from '../config/site';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function getCategory(post: (typeof allPosts)[number]) {
  if (post.data.category) return post.data.category;
  if (post.data.tags.length > 0) return post.data.tags[0];
  return 'お知らせ';
}

const trustPoints = [
  {
    title: '建設業許可と継続手続に注力',
    text: '新規申請だけでなく、更新、決算変更届、業種追加など、許可取得後の継続手続も重視しています。',
  },
  {
    title: '泉州と和歌山北部をまたぐ対応力',
    text: '阪南市の立地を活かし、大阪泉州・和歌山北部を中心に、機動的で相談しやすい対応を目指しています。',
  },
  {
    title: '初めての方にもわかりやすく説明',
    text: '専門用語をできるだけ噛み砕き、必要な確認事項や手続の流れを整理してご案内します。',
  },
];

const concerns = [
  '元請や取引先から建設業許可の取得を求められた',
  '500万円以上の工事を請けたい',
  '自社が許可要件を満たすのか分からない',
  '更新や決算変更届が不安',
  '今後、業種追加や法人成りも考えている',
  '泉州・和歌山北部で相談しやすい事務所を探している',
];

const services = [
  {
    title: '建設業許可 新規申請',
    text: '許可が必要かどうかの確認から、要件整理、必要資料のご案内まで丁寧にサポートします。',
    href: '/service/construction-permit/',
  },
  {
    title: '建設業許可 更新申請',
    text: '5年ごとの更新手続に向けて、必要な確認事項や準備の流れをご案内します。',
    href: '/service/construction-permit/',
  },
  {
    title: '決算変更届',
    text: '許可取得後に毎年必要となる重要な届出です。更新や今後の手続にも関わります。',
    href: '/service/construction-permit/',
  },
  {
    title: '業種追加・各種変更届',
    text: '事業拡大や体制変更に応じて必要となる手続について、状況に応じて整理します。',
    href: '/service/construction-permit/',
  },
  {
    title: '将来的な経審・入札の準備',
    text: '公共工事を視野に入れた際に大切になる日頃の許可管理や、準備の流れについても見据えます。',
    href: '/service/construction-permit/',
  },
  {
    title: 'その他の許認可・法人関連手続',
    text: '建設業以外の許認可や法人関連手続についても、内容に応じて対応いたします。',
    href: '/service/',
  },
];

const flowSteps = [
  {
    step: 'STEP 1',
    title: 'お問い合わせ',
    text: 'お電話・公式LINE等にて、建設業許可の要否や現在の状況を含め、ご用件の概要をお伺いします。',
  },
  {
    step: 'STEP 2',
    title: '面談・ヒアリング',
    text: '事実関係や今後のご予定を確認し、必要な手続きとスケジュールをご説明します。',
  },
  {
    step: 'STEP 3',
    title: 'ご提案・お見積り',
    text: '業務内容・報酬を明確にしたうえで、ご納得いただいてから着手します。',
  },
  {
    step: 'STEP 4',
    title: '受任・手続き遂行',
    text: '書類作成、申請・提出、必要に応じた継続手続のご案内まで対応いたします。',
  },
];
---

<BaseLayout
  title={pageTitle('大阪泉州・和歌山北部の建設業許可')}
  description="大阪府阪南市拠点。泉州・和歌山北部の建設業者向けに、新規申請・更新・決算変更届・業種追加を丁寧にサポート。許可取得後の継続手続も見据えたご案内。"
>
  <div class="page">
    <SiteHeader />

    <main>
      <section class="hero section--base" aria-labelledby="hero-heading">
        <div class="hero__inner">
          <div class="hero__content">
            <p class="hero__label">大阪泉州・和歌山北部対応</p>
            <h1 id="hero-heading" class="hero__catch">
              建設業許可と、その後の手続きを<br class="hero__catch-br" aria-hidden="true" />
              わかりやすく丁寧にサポート
            </h1>
            <p class="hero__office">やちよ行政書士事務所</p>
            <p class="hero__lead">
              大阪府阪南市を拠点に、岸和田・和泉・泉佐野などの泉州エリアから和歌山北部まで。
              建設業許可の新規申請、更新、決算変更届、業種追加など、許可取得後の継続手続まで見据えてサポートします。
            </p>
            <p class="hero__sublead">
              南大阪と和歌山をまたぐ立地を活かし、地域密着のフットワークで対応します。
            </p>
            <div class="hero__actions">
              <a href="/service/construction-permit/" class="hero__btn hero__btn--primary">
                建設業許可サポートを見る
              </a>
              <a href="/contact" class="hero__btn hero__btn--outline">お問い合わせ</a>
            </div>
          </div>

          <figure class="hero__visual">
            <img
              src="/images/construction-hero.jpg"
              alt="建設業許可サポートをイメージする建設現場"
              loading="eager"
            />
          </figure>
        </div>
      </section>

      <section class="trust section--band" aria-label="事務所の特徴">
        <div class="trust__inner">
          <ul class="trust__list">
            {trustPoints.map((item) => (
              <li class="trust__item">
                <span class="trust__icon" aria-hidden="true"></span>
                <p class="trust__title">{item.title}</p>
                <p class="trust__text">{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section section--base" aria-labelledby="concerns-heading">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 id="concerns-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              こんなお悩みはありませんか
            </h2>
            <p class="section__sub">
              建設業許可は、取得の可否だけでなく、更新や決算変更届など取得後の管理まで見据えることが大切です。
            </p>
          </div>

          <ul class="concern-list">
            {concerns.map((item) => (
              <li class="concern-item">{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section id="about" class="section section--band">
        <div class="section__inner section__grid">
          <div class="section__intro">
            <h2 class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              事務所について
            </h2>
          </div>
          <div class="section__body">
            <p class="section__lead">
              やちよ行政書士事務所は、大阪泉州・和歌山北部の事業者さまを中心に、建設業許可とその後の継続手続を支えることを重視する行政書士事務所です。
            </p>
            <p class="section__text">
              建設業許可は取得して終わりではなく、決算変更届、更新、各種変更届など継続的な管理が欠かせません。
              当事務所では、初めて許可取得を検討される方にも、今後の流れまで見通しやすくご案内できるよう努めています。
            </p>
            <a href="/about" class="section__more">事務所概要・代表者紹介を見る →</a>
          </div>
        </div>
      </section>

      <section id="services" class="section section--base">
        <div class="section__inner">
          <div class="section__head-block">
            <h2 class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              主なサポート内容
            </h2>
            <p class="section__sub">
              建設業許可を中心に、取得から維持・変更まで継続的な手続きを見据えてご案内します。
            </p>
          </div>

          <ul class="service-list">
            {services.map((service) => (
              <li class="service-card">
                <a href={service.href} class="service-card__link">
                  <h3 class="service-card__title">
                    <span class="service-card__dot" aria-hidden="true"></span>
                    {service.title}
                  </h3>
                  <p class="service-card__text">{service.text}</p>
                  <span class="service-card__more">詳しく見る →</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section section--band" aria-labelledby="flow-heading">
        <div class="section__inner section__inner--narrow-flow">
          <h2 id="flow-heading" class="section__heading section__heading--center">
            <span class="heading-icon" aria-hidden="true"></span>
            ご相談の流れ
          </h2>

          <ol class="flow-list">
            {flowSteps.map((item) => (
              <li class="flow-step">
                <span class="flow-step__label">{item.step}</span>
                <p class="flow-step__title">{item.title}</p>
                <p class="flow-step__text">{item.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section id="news" class="section section--base" aria-labelledby="news-heading">
        <div class="section__inner section__inner--news">
          <div class="news__head">
            <h2 id="news-heading" class="section__heading">
              <span class="heading-icon" aria-hidden="true"></span>
              新着ブログ・お知らせ
            </h2>
            <a href="/blog/" class="news__more">ブログ一覧へ</a>
          </div>

          {
            latestPosts.length === 0 ? (
              <p class="news__empty">現在、公開中の記事はありません。</p>
            ) : (
              <ul class="news-list">
                {latestPosts.map((post) => (
                  <li>
                    <a href={`/blog/${post.slug}/`} class="news-item">
                      <time class="news-item__date" datetime={post.data.pubDate.toISOString()}>
                        {formatDate(post.data.pubDate)}
                      </time>
                      <span class="news-item__category">{getCategory(post)}</span>
                      <span class="news-item__title">{post.data.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </section>

      <section id="contact" class="section section--band section--contact">
        <div class="section__inner section__inner--contact">
          <div class="contact-card">
            <h2 class="contact-card__heading">
              <span class="heading-icon heading-icon--light" aria-hidden="true"></span>
              お問い合わせ
            </h2>
            <p class="contact-card__text">
              建設業許可が必要かどうか分からない段階でも構いません。ご状況を整理しながら、必要な手続の方向性をご案内します。
            </p>

            <dl class="contact-card__dl">
              <div class="contact-card__row">
                <dt>電話</dt>
                <dd>（掲載準備中）</dd>
              </div>
              <div class="contact-card__row">
                <dt>受付時間</dt>
                <dd>平日 9:00〜18:00 ※事前予約で土日祝・時間外も対応可</dd>
              </div>
              <div class="contact-card__row contact-card__row--line">
                <dt>公式LINE</dt>
                <dd><LineButton block /></dd>
              </div>
            </dl>

            <a href="/contact" class="contact-card__btn">
              お問い合わせフォームへ進む
            </a>

            <p class="contact-card__note">
              ※ お問い合わせフォーム・公式LINEは24時間受付しております。平日9:00〜18:00以外の時間帯のご連絡は、原則翌営業日以降のご返信となります。
            </p>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: #ffffff;
  }

  .section--base {
    background: #ffffff;
  }

  .section--band {
    background: #f8fafc;
    border-block: 1px solid var(--color-border);
  }

  .heading-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.4rem;
    background: #1e3a8a;
    flex-shrink: 0;
    vertical-align: middle;
    margin-right: 0.65rem;
  }

  .heading-icon::after {
    content: '';
    width: 0.55rem;
    height: 0.72rem;
    border: 2px solid #fff;
    border-radius: 2px;
  }

  .heading-icon--light {
    background: #1e3a8a;
  }

  .section__heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    margin: 0 0 1rem;
    font-size: clamp(1.2rem, 2.8vw, 1.45rem);
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.05em;
    line-height: 1.4;
  }

  .section__heading--center {
    justify-content: center;
    text-align: center;
    margin-bottom: 2.25rem;
  }

  .hero {
    padding: clamp(3.25rem, 9vw, 5.75rem) var(--space-section-x)
      max(var(--space-section-y), 3.75rem);
  }

  .hero__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    display: grid;
    gap: 2rem 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr);
    }
  }

  .hero__label {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--color-primary);
  }

  .hero__catch {
    margin: 0 0 1.35rem;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(1.75rem, 6.5vw, 2.875rem);
    line-height: 1.35;
    letter-spacing: 0.04em;
    color: var(--color-text);
    max-width: 14em;
  }

  .hero__catch-br {
    display: none;
  }

  @media (max-width: 767px) {
    .hero__catch-br {
      display: inline;
    }
  }

  .hero__office {
    margin: 0 0 1rem;
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-primary);
  }

  .hero__lead {
    margin: 0 0 1rem;
    max-width: 42rem;
    font-size: clamp(0.9375rem, 2.2vw, 1.0625rem);
    line-height: 1.95;
    color: var(--color-text-muted);
  }

  .hero__sublead {
    margin: 0 0 2.25rem;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1rem;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0 1.5rem;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .hero__btn--primary {
    background: #1e3a8a;
    color: #fff;
    border: 2px solid #1e3a8a;
  }

  .hero__btn--primary:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    color: #fff;
  }

  .hero__btn--outline {
    background: #fff;
    color: var(--color-primary);
    border: 2px solid #1e3a8a;
  }

  .hero__btn--outline:hover {
    background: var(--color-band);
    color: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
  }

  .hero__visual {
    margin: 0;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    background: #f3f6fb;
  }

  .hero__visual img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 260px;
    object-fit: cover;
  }

  .trust {
    padding: var(--space-section-y) var(--space-section-x);
  }

  .trust__inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .trust__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .trust__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }

  .trust__item {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.65rem 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .trust__icon {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius);
    background: #1e3a8a;
    margin-bottom: 1rem;
    position: relative;
  }

  .trust__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 0.55rem;
    height: 0.72rem;
    border: 2px solid #fff;
    border-radius: 2px;
  }

  .trust__title {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0.02em;
  }

  .trust__text {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .section {
    padding: var(--space-section-y) var(--space-section-x);
  }

  .section--contact {
    padding-bottom: max(var(--space-section-y), 4rem);
  }

  .section__inner {
    max-width: var(--content-max);
    margin: 0 auto;
  }

  .section__inner--narrow-flow {
    max-width: 48rem;
  }

  .section__inner--contact {
    max-width: 42rem;
  }

  .section__inner--news {
    max-width: 52rem;
  }

  .section__head-block {
    margin-bottom: 2rem;
  }

  .section__sub {
    margin: 0;
    max-width: 42rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.85;
  }

  .section__grid {
    display: grid;
    gap: 1.75rem 2.75rem;
  }

  @media (min-width: 768px) {
    .section__grid {
      grid-template-columns: minmax(11rem, 15rem) 1fr;
      align-items: start;
    }
  }

  .section__intro {
    padding-top: 0.2rem;
  }

  .section__lead {
    margin: 0 0 1.1rem;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.85;
    color: var(--color-text);
  }

  .section__text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.9;
    color: var(--color-text-muted);
  }

  .section__more {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .section__more:hover {
    color: var(--color-primary-hover);
    border-bottom-color: rgba(30, 58, 138, 0.35);
  }

  .concern-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  @media (min-width: 768px) {
    .concern-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .concern-item {
    position: relative;
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1rem 1rem 1rem 2.75rem;
    line-height: 1.8;
    color: var(--color-text);
    box-shadow: var(--shadow-sm);
  }

  .concern-item::before {
    content: '✓';
    position: absolute;
    left: 1rem;
    top: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .service-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .service-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .service-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .service-card:hover {
