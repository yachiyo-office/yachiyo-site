---
const nav = [
  { href: '/construction-permit/', label: '建設業許可サポート' },
  { href: '/about', label: '事務所概要' },
  { href: '/price', label: '料金案内' },
  { href: '/blog/', label: 'ブログ' },
  { href: '/contact', label: 'お問い合わせ' },
];

/** 公開時に実番号へ差し替えください */
const phoneDisplay = '（掲載準備中）';
---

<header class="header" id="site-header">
  <div class="header__inner">
    <div class="header__row">
      <a href="/" class="header__brand">
        <img
          class="header__logo"
          src="/logo.webp"
          alt="やちよ行政書士事務所"
          width="320"
          height="273"
          loading="eager"
          decoding="async"
        />
        <span class="header__name">
          やちよ行政書士事務所<span class="header__name-note">（開業準備中）</span>
        </span>
      </a>
      <div class="header__aside">
        <span class="header__phone">
          <span class="header__phone-label">お電話</span>
          <span class="header__phone-num">{phoneDisplay}</span>
        </span>
        <a href="/contact" class="header__btn">お問い合わせ</a>
      </div>
    </div>
    <nav class="header__nav" aria-label="メインナビゲーション">
      <ul class="header__list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="header__nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');

  if (header) {
    let lastScrollY = window.scrollY;
    let ticking = false;

    const setHeaderHeight = () => {
      document.documentElement.style.setProperty(
        '--site-header-height',
        `${header.offsetHeight}px`,
      );
    };

    const updateHeader = () => {
      const currentScrollY = window.scrollY;

      if (currentScrollY <= 0) {
        header.classList.remove('header--hidden');
      } else if (currentScrollY > lastScrollY) {
        header.classList.add('header--hidden');
      } else {
        header.classList.remove('header--hidden');
      }

      lastScrollY = currentScrollY;
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(updateHeader);
        ticking = true;
      }
    };

    setHeaderHeight();
    window.addEventListener('resize', setHeaderHeight, { passive: true });
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('load', setHeaderHeight);
  }
</script>

<style>
  :global(body) {
    padding-top: var(--site-header-height, 0px);
  }

  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 50;
    background: #ffffff;
    border-bottom: 2px solid #1e3a8a;
    box-shadow: var(--shadow-sm);
    padding-top: max(0.5rem, env(safe-area-inset-top));
    transform: translateY(0);
    transition: transform 0.3s ease;
    will-change: transform;
  }

  .header--hidden {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .header {
      transition: none;
    }
  }

  .header__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0.75rem var(--space-section-x) 0.875rem;
  }

  .header__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.25rem;
  }

  .header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .header__brand:hover .header__name {
    color: var(--color-primary);
  }

  .header__logo {
    width: auto;
    height: 2.5rem;
    flex-shrink: 0;
    object-fit: contain;
    border-radius: 0.35rem;
  }

  @media (min-width: 480px) {
    .header__logo {
      height: 2.75rem;
    }
  }

  @media (min-width: 768px) {
    .header__logo {
      height: 3rem;
    }
  }

  .header__name {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(0.9375rem, 3.8vw, 1.1875rem);
    letter-spacing: 0.06em;
    line-height: 1.35;
    color: var(--color-text);
    transition: color 0.15s ease;
  }

  .header__name-note {
    margin-left: 0.3em;
    font-size: 0.72em;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .header__aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem 1rem;
  }

  .header__phone {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .header__phone-label {
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .header__phone-num {
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    color: var(--color-primary);
  }

  .header__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0 1.15rem;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #fff;
    background: #1e3a8a;
    border-radius: var(--radius);
    border: 2px solid #1e3a8a;
    text-decoration: none;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .header__btn:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    color: #fff;
  }

  .header__nav {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .header__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    padding: 0.35rem 0;
    border-bottom: 2px solid transparent;
    text-decoration: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .header__nav-link:hover {
    color: var(--color-primary);
    border-bottom-color: rgba(30, 58, 138, 0.35);
  }

  @media (max-width: 639px) {
    .header__row {
      flex-direction: column;
      align-items: stretch;
    }

    .header__brand {
      justify-content: flex-start;
    }

    .header__aside {
      justify-content: space-between;
      width: 100%;
    }

    .header__btn {
      flex: 1;
      min-width: min(100%, 11rem);
    }
  }
</style>
