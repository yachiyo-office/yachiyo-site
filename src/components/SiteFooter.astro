---
const nav = [
  { href: '/', label: 'ホーム' },
  { href: '/construction-permit/', label: '建設業サポート' },
  { href: '/service/', label: '業務案内' },
  { href: '/about', label: '事務所概要' },
  { href: '/price', label: '料金案内' },
  { href: '/blog/', label: 'ブログ' },
  { href: '/contact', label: 'お問い合わせ' },
  { href: '/privacy/', label: 'プライバシーポリシー' },
];
---

<footer class="footer">
  <div class="footer__inner">
    <p class="footer__name">やちよ行政書士事務所</p>
    <nav class="footer__nav" aria-label="フッターナビゲーション">
      <ul class="footer__list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="footer__nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="footer__copy">
      &copy; {new Date().getFullYear()} やちよ行政書士事務所
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    background: var(--color-band);
    color: var(--color-text);
    border-top: 1px solid var(--color-border);
  }

  .footer__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 2.25rem var(--space-section-x);
    padding-bottom: max(2.25rem, env(safe-area-inset-bottom));
    text-align: center;
  }

  .footer__name {
    margin: 0 0 1.25rem;
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.06em;
    color: var(--color-primary);
  }

  .footer__nav {
    margin-bottom: 1.5rem;
  }

  .footer__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__nav-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    padding: 0.35rem 0;
    border-bottom: 2px solid transparent;
    text-decoration: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .footer__nav-link:hover {
    color: var(--color-primary);
    border-bottom-color: rgba(30, 58, 138, 0.35);
  }

  .footer__copy {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
</style>
