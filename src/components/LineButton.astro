---
import { lineOfficialUrl, lineButtonLabel } from '../config/contact';

interface Props {
  label?: string;
  block?: boolean;
}

const { label = lineButtonLabel, block = false } = Astro.props;
const blockClass = block ? 'line-button--block' : '';
---

<a
  href={lineOfficialUrl}
  class:list={['line-button', blockClass]}
  target="_blank"
  rel="noopener noreferrer"
>
  <span>{label}</span>
</a>

<style>
  .line-button {
    display: inline-block;
    margin-bottom: 1rem;
    background-color: #06c755;
    color: #fff;
    padding: 14px 28px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9375rem;
    letter-spacing: 0.03em;
    text-align: center;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: background-color 0.2s ease;
  }

  .line-button:hover {
    background-color: #05b34c;
    color: #fff;
  }

  .line-button span {
    color: inherit;
  }

  .line-button--block {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3rem;
    margin-bottom: 0;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius);
    box-sizing: border-box;
  }
</style>
